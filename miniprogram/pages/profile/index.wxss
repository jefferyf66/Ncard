/* ==========================================
   Ncard 个人中心 · 品牌蓝设计系统
   ========================================== */

.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  background: linear-gradient(175deg, #EFF6FF 0%, #F8FAFC 40%, #FEFCF7 100%);
}

/* ============ USER CARD ============ */
.user-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.04);
  border: 2rpx solid #E2E8F0;
}

.user-bg {
  height: 120rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
}

.user-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 28rpx 28rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 1;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 4rpx;
  border: 4rpx solid #FFFFFF;
  background: #F1F5F9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-top: 48rpx;
}

.user-name {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 36rpx;
  font-weight: 600;
  color: #0F172A;
}

.user-desc {
  font-size: 26rpx;
  color: #64748B;
}

/* ============ STATS CARD ============ */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(170deg, #FFFFFF 0%, #FEFCF7 100%);
  border-radius: 8rpx;
  padding: 36rpx 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.03);
  border: 2rpx solid #E2E8F0;
}

.stat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 4rpx;
  background: rgba(59, 130, 246, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-card {
  width: 36rpx;
  height: 44rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 4rpx;
  position: relative;
}

.icon-card::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 8rpx;
  right: 8rpx;
  height: 2rpx;
  background: #3B82F6;
  box-shadow: 0 8rpx 0 #3B82F6;
}

.icon-users {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.icon-users::before,
.icon-users::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
  top: 0;
}

.icon-users::before { left: 0; }
.icon-users::after { right: 0; }

.icon-team {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 6rpx;
  position: relative;
}
.icon-team::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 8rpx;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
}

.stat-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-value {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #0F172A;
}

.stat-label {
  font-size: 24rpx;
  color: #64748B;
}

/* ============ MENU GROUP ============ */
.menu-group {
  margin-bottom: 24rpx;
}

.menu-header {
  padding: 0 8rpx 16rpx;
}

.menu-title {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.03);
  border: 2rpx solid #E2E8F0;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border-bottom: 2rpx solid #F1F5F9;
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F8FAFC;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 4rpx;
  background: rgba(59, 130, 246, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #334155;
  font-weight: 500;
}

.menu-arrow {
  font-size: 36rpx;
  color: #94A3B8;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-subtext {
  font-size: 26rpx;
  color: #94A3B8;
}

/* ============ ICONS ============ */
.icon-trash,
.icon-info {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-trash::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border: 2rpx solid #EF4444;
  border-radius: 4rpx;
}

.icon-trash::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 4rpx;
  background: #EF4444;
  border-radius: 2rpx;
}

.icon-info {
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
}

.icon-info::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 16rpx;
  background: #3B82F6;
}

/* 单人头像图标（账号设置菜单） */
.icon-user {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-user::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
}

.icon-user::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 12rpx;
  border: 2rpx solid #3B82F6;
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}

/* ============ VERSION ============ */
.version-info {
  text-align: center;
  padding: 32rpx 0;
}

.version-text {
  font-size: 24rpx;
  color: #94A3B8;
}
