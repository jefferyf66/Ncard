<view class="container">
  <view class="user-card">
    <view class="user-bg"></view>
    <view class="user-content">
      <image class="user-avatar" src="{{(userInfo && userInfo.avatarUrl) || '../../images/avatar.png'}}" mode="aspectFill"></image>
      <view class="user-info">
        <text class="user-name">{{(userInfo && userInfo.nickname) || '微信用户'}}</text>
        <text class="user-desc">{{openid ? '已登录' : '请登录以使用完整功能'}}</text>
      </view>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item" bindtap="goToMyCards">
      <view class="stat-icon-wrap">
        <view class="icon-card"></view>
      </view>
      <view class="stat-info">
        <text class="stat-value">{{cardCount}}</text>
        <text class="stat-label">我的名片</text>
      </view>
    </view>
    <view class="stat-item" bindtap="goToVisitors">
      <view class="stat-icon-wrap">
        <view class="icon-users"></view>
      </view>
      <view class="stat-info">
        <text class="stat-value">{{visitorCount}}</text>
        <text class="stat-label">访客</text>
      </view>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-header">
      <text class="menu-title">名片管理</text>
    </view>
    <view class="menu-card">
      <view class="menu-item" bindtap="goToCardList">
        <view class="menu-icon-wrap">
          <view class="icon-card"></view>
        </view>
        <text class="menu-text">我的名片夹</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToVisitors">
        <view class="menu-icon-wrap">
          <view class="icon-users"></view>
        </view>
        <text class="menu-text">访客记录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToTeam">
        <view class="menu-icon-wrap">
          <view class="icon-team"></view>
        </view>
        <text class="menu-text">我的团队</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-header">
      <text class="menu-title">设置</text>
    </view>
    <view class="menu-card">
      <view class="menu-item" bindtap="goToAccount">
        <view class="menu-icon-wrap">
          <view class="icon-user"></view>
        </view>
        <text class="menu-text">账号设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-group" wx:if="{{isAdmin}}">
    <view class="menu-header">
      <text class="menu-title">运营</text>
    </view>
    <view class="menu-card">
      <view class="menu-item" bindtap="goToAdmin">
        <view class="menu-icon-wrap">
          <view class="icon-team"></view>
        </view>
        <text class="menu-text">管理后台</text>
        <view class="menu-right">
          <text class="menu-subtext">{{userRole}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-header">
      <text class="menu-title">更多</text>
    </view>
    <view class="menu-card">
      <view class="menu-item" bindtap="clearCache">
        <view class="menu-icon-wrap">
          <view class="icon-trash"></view>
        </view>
        <text class="menu-text">清空缓存</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="showAbout">
        <view class="menu-icon-wrap">
          <view class="icon-info"></view>
        </view>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="version-info">
    <text class="version-text">投贴儿 v{{version}}</text>
  </view>
</view>
