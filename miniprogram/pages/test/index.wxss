/* pages/test/index.wxss */
.test-container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #EEF2FF 0%, #F5F5F5 100%);
}

.test-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.test-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 16rpx;
}

.test-status {
  display: block;
  font-size: 28rpx;
  color: #3B82F6;
}

.test-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 24rpx;
}

.test-btn {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #F1F5F9;
  color: #475569;
  font-size: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: none;
  text-align: center;
}

.test-btn.primary {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  font-weight: 600;
}

.test-btn::after {
  border: none;
}

.test-tips {
  background: #FEF3C7;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 48rpx;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #92400E;
  margin-bottom: 12rpx;
}

.tips-item {
  display: block;
  font-size: 26rpx;
  color: #78350F;
  line-height: 1.6;
}
