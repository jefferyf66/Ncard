.container {
  min-height: 100vh;
  background: linear-gradient(175deg, #FAFBFC 0%, #FEFCF9 30%, #F6F8FC 100%);
}

/* 分享卡片 Canvas（隐藏，仅用于保存时生成分享图） */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  pointer-events: none;
}

.page-content {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

/* ===== 头像区 ===== */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 48rpx;
}

.avatar-wrapper {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #F8FAFC 100%);
  border: 4rpx solid rgba(59, 130, 246, 0.12);
  transition: border-color 0.3s;
}

.avatar-wrapper:active .avatar {
  border-color: #3B82F6;
}

.avatar-mask {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mask-icon {
  width: 100%;
  height: 100%;
  background: #3B82F6;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.22);
  transition: transform 0.2s;
}

.mask-icon:active {
  transform: scale(0.9);
}

.icon-plus {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.icon-plus::before,
.icon-plus::after {
  content: '';
  position: absolute;
  background: #FFFFFF;
}

.icon-plus::before {
  width: 24rpx;
  height: 2rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.icon-plus::after {
  width: 2rpx;
  height: 24rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.avatar-tip {
  font-size: 28rpx;
  color: #94A3B8;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid #F1F5F9;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  margin-bottom: 16rpx;
  border-bottom: 2rpx solid #F1F5F9;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
  font-family: Georgia, 'Times New Roman', 'PingFang SC', serif;
}

.add-btn {
  font-size: 28rpx;
  color: #3B82F6;
  font-weight: 500;
}

.form-group {
  padding: 0;
}
.form-group .form-group {
  padding: 0;
}

/* 内层 form-group：与基本信息字段样式对齐（label-row + form-input） */
.form-group-inner {
  margin-top: 16rpx;
}

.form-label-row {
  display: flex;
  align-items: flex-start;   /* 顶部对齐：避免 center 把 label 推到 input 内部 */
  gap: 8rpx;
  margin-bottom: 12rpx;       /* label ↔ input 之间稳定间距 */
}

.form-label {
  font-size: 26rpx;
  color: #64748B;
  font-weight: 500;
  line-height: 1.4;
}

.required {
  color: #EF4444;
  font-size: 24rpx;
  line-height: 1.4;
}

.managed-hint-inline {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #B45309;
  margin-left: 8rpx;
  gap: 6rpx;
}

/* ===== 输入框（统一完整边框圆角风格，与 textarea 对齐）=====
   真机原生 <input> 在「border-bottom + padding 0」模式下，
   iOS webview 把 1px 下边框吃进 padding，挤压上方 label 视觉。
   改完整四向边框 + 圆角 + 灰底，input/textarea/wrap 三档统一：
   - input           单行字段（姓名/职位/公司）
   - form-input-wrap 单行 + 右侧 visibility-toggle 按钮
   - form-textarea   多行字段
   所有 box 都用 border-radius:8rpx + background:#F8FAFC，
   真机原生 input padding 渲染稳，label 在上方独立行不再被推入。 */
.form-input,
.form-input-wrap,
.form-textarea {
  box-sizing: border-box;
  width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
  color: #0F172A;
  text-align: left;
}

.form-input {
  display: block;
  padding: 18rpx 20rpx;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 4rpx;          /* 4rpx 锐角,贴合 Hybrid 风格 */
  min-height: 80rpx;            /* 撑出垂直空间,稳基线 */
  transition: border-color 0.2s, background 0.2s;
}
.form-input:focus {
  background: #FFFFFF;
  border-color: #3B82F6;
  outline: none;
}
.form-input.input-error {
  border-color: #EF4444;
}
.form-input::placeholder {
  color: #94A3B8;
  font-size: 28rpx;
  line-height: 1.5;
}

.form-textarea {
  display: block;
  padding: 20rpx 24rpx;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 4rpx;          /* 4rpx 锐角，与 input 统一 */
  min-height: 160rpx;
  transition: border-color 0.2s, background 0.2s;
}
.form-textarea:focus {
  background: #FFFFFF;
  border-color: #3B82F6;
  outline: none;
}
.form-textarea::placeholder {
  color: #94A3B8;
  font-size: 28rpx;
  line-height: 1.5;
}

.form-error {
  font-size: 24rpx;
  color: #EF4444;
  padding-top: 6rpx;
  text-align: left;
}

.form-divider {
  height: 1px;
  background: #F1F5F9;
  margin: 4rpx 0;
}

/* ===== 可见性图标按钮（input 右侧） ===== */
.form-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 20rpx;
  background: #F8FAFC;
  border: 1px solid #E2E8F0;
  border-radius: 4rpx;          /* 与 input 一致 */
  min-height: 80rpx;
  transition: border-color 0.2s, background 0.2s;
}
.form-input-wrap:focus-within {
  background: #FFFFFF;
  border-color: #3B82F6;
}
/* wrap 内的 input 必须去掉自己的边框/灰底,否则双重 box
   关键修复（v1.5.4）：
   - 去掉 min-height:56rpx（border-box 下 padding 18rpx*2=36rpx，仅剩 20rpx 文本区，
     把 30rpx 字号纵向裁掉一半 → 真机「邮箱栏挡」根因）
   - 改 min-height 继承外层 .form-input 的 80rpx（内容区 44rpx ≥ 字号，不再裁切）
   - padding-right:12rpx + min-width:0：长文本（如邮箱）不与右侧可见性图标重叠 */
.form-input-wrap .form-input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 18rpx 12rpx 18rpx 0;
}
.form-input-wrap .form-input:focus {
  border: none;
  outline: none;
}

.form-textarea-wrap {
  position: relative;
}
.form-textarea-wrap .form-textarea {
  padding-bottom: 56rpx;
}

.visibility-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  background: #F1F5F9;
  flex-shrink: 0;
  transition: background 0.2s, transform 0.1s;
  position: relative;
}
.visibility-toggle:active {
  transform: scale(0.92);
  background: #E2E8F0;
}
.visibility-toggle-corner {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
}

/* ===== 可见性 SVG 矢量图标（base64 data-URI，真机零渲染差异）=====
   三档语义：
   - public        蓝色地球     全员可见
   - authorized    绿色眼睛     对方访问名片后可见
   - private       灰色锁       仅自己可见
   SVG 在 setData.visIcons 中按状态切换 src
*/
.vi-svg {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

/* ===== 可见性首次提示气泡 ===== */
.visibility-tip {
  position: fixed;
  left: 50%;
  bottom: 180rpx;
  transform: translateX(-50%);
  background: rgba(15, 23, 42, 0.92);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  z-index: 998;
  line-height: 1.6;
  max-width: 560rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

/* ===== 经历编辑器 ===== */
.experience-editor {
  margin-top: 16rpx;
}

.exp-item {
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-left: 4rpx solid transparent;
  transition: border-color 0.2s;
}

.exp-item:active {
  border-left-color: #3B82F6;
}

.exp-row {
  margin-bottom: 16rpx;
}

.exp-row:last-child {
  margin-bottom: 0;
}

.exp-input {
  width: 100%;
  font-size: 28rpx;
  color: #0F172A;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border-radius: 4rpx;
  border: 2rpx solid #E2E8F0;
  transition: border-color 0.2s;
}

.exp-input:focus {
  border-color: #3B82F6;
}

.exp-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #0F172A;
  padding: 16rpx 20rpx;
  background: #FFFFFF;
  border-radius: 4rpx;
  border: 2rpx solid #E2E8F0;
  min-height: 120rpx;
  transition: border-color 0.2s;
}

.exp-textarea:focus {
  border-color: #3B82F6;
}

.exp-delete {
  text-align: right;
  font-size: 24rpx;
  color: #EF4444;
  padding-top: 8rpx;
}

/* ===== 上传区 ===== */
.upload-area {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.upload-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 4rpx;
  border: 2rpx solid #E2E8F0;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #CBD5E1;
  border-radius: 4rpx;
  gap: 8rpx;
  transition: border-color 0.2s;
}

.upload-placeholder:active {
  border-color: #3B82F6;
}

.upload-placeholder text {
  font-size: 22rpx;
  color: #94A3B8;
}

.icon-upload {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 4rpx;
  position: relative;
}

.icon-upload::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 2rpx;
  background: #3B82F6;
  transform: translate(-50%, -50%);
}

.icon-upload::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 2rpx;
  height: 20rpx;
  background: #3B82F6;
  transform: translate(-50%, -50%);
}

/* ===== 附件编辑器 ===== */
.attachment-editor {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.attach-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: 8rpx;
  border-left: 4rpx solid transparent;
  transition: border-color 0.2s;
}

.attach-item:active {
  border-left-color: #3B82F6;
}

.attach-icon-small {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-file {
  width: 36rpx;
  height: 44rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 4rpx;
  position: relative;
}

.icon-file::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 2rpx;
}

.icon-file::after {
  content: '';
  position: absolute;
  top: 28rpx;
  left: 6rpx;
  right: 6rpx;
  height: 2rpx;
  background: #3B82F6;
  box-shadow: 0 6rpx 0 #3B82F6;
}

.attach-name-small {
  flex: 1;
  font-size: 28rpx;
  color: #334155;
}

.attach-delete {
  font-size: 24rpx;
  color: #EF4444;
}

.empty-tip {
  text-align: center;
  font-size: 26rpx;
  color: #94A3B8;
  padding: 32rpx;
}

/* ===== 底部操作栏 — 不透明 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid #F1F5F9;
  box-shadow: 0 -1rpx 8rpx rgba(0, 0, 0, 0.03);
  z-index: 999;
  pointer-events: auto;
}

/* 保存按钮 — 不透明纯色 */
.save-btn {
  background: #3B82F6;
  padding: 32rpx;
  text-align: center;
  border-radius: 4rpx;
  transition: background 0.2s, transform 0.2s;
  pointer-events: auto;
}

.save-btn:active {
  background: #2563EB;
  transform: scale(0.99);
}

/* ===== 开关组件 ===== */
.switch-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.switch {
  width: 80rpx;
  height: 44rpx;
  background: #E2E8F0;
  border-radius: 22rpx;
  position: relative;
  transition: background 0.2s;
}

.switch-on {
  background: #3B82F6;
}

.switch-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.2s;
}

.switch-on .switch-thumb {
  transform: translateX(36rpx);
}

.switch-text {
  font-size: 24rpx;
  color: #64748B;
}

/* ===== 头部右侧区域 ===== */
.header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* ===== 拖拽手柄 ===== */
.exp-item {
  display: flex;
  gap: 16rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-left: 4rpx solid transparent;
  transition: border-color 0.2s, transform 0.2s;
}

.exp-item:active {
  border-left-color: #3B82F6;
  transform: scale(0.995);
}

.exp-drag-handle {
  width: 48rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: grab;
}

.exp-drag-handle:active {
  cursor: grabbing;
}

.drag-icon {
  width: 24rpx;
  height: 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-around;
}

.drag-icon::before,
.drag-icon::after {
  content: '';
  display: block;
  width: 20rpx;
  height: 4rpx;
  background: #94A3B8;
  border-radius: 2rpx;
}

.drag-icon::after {
  margin-top: 6rpx;
}

.exp-content {
  flex: 1;
}

/* ===== 拖拽排序时的样式 ===== */
.exp-item.dragging {
  opacity: 0.5;
  background: #E0E7FF;
}

.exp-item.drag-over {
  border-top: 4rpx dashed #3B82F6;
}

.btn-text {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ===== 加载态 ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E2E8F0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #94A3B8;
}

/* ===== 团队托管字段（T12） ===== */
.managed-banner {
  display: flex;
  align-items: center;
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
.managed-banner-text { font-size: 24rpx; color: #B45309; margin-left: 12rpx; line-height: 1.5; }

.managed-hint {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #B45309;
}
.lock-icon-sm {
  width: 22rpx; height: 22rpx; margin-right: 8rpx;
  border: 3rpx solid #B45309; border-radius: 4rpx; position: relative;
}
.lock-icon-sm::before {
  content: ''; position: absolute; left: 50%; top: -10rpx; transform: translateX(-50%);
  width: 12rpx; height: 10rpx; border: 3rpx solid #B45309; border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
}

.team-join-block { padding: 24rpx 0; }
.join-tip { display: block; font-size: 24rpx; color: #94A3B8; margin: 12rpx 0 16rpx; line-height: 1.5; }
.join-row { display: flex; align-items: center; gap: 16rpx; }
.join-input {
  flex: 1; height: 80rpx; background: #F8FAFC; border: 2rpx solid #E2E8F0;
  border-radius: 12rpx; padding: 0 20rpx; font-size: 32rpx; font-weight: 700;
  letter-spacing: 4rpx; color: #1F2937;
}
.join-btn {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); color: #fff;
  font-size: 28rpx; font-weight: 600; padding: 20rpx 32rpx; border-radius: 12rpx;
}
.join-btn.disabled { opacity: 0.6; }

/* ===== 公众号二维码上传 ===== */
.qr-group { margin-top: 24rpx; }
.qr-uploader {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: 12rpx;
}
.qr-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 4rpx;
  border: 2rpx solid #E2E8F0;
}
.qr-placeholder {
  width: 200rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #CBD5E1;
  border-radius: 4rpx;
  font-size: 22rpx;
  color: #94A3B8;
  padding: 0 12rpx;
  text-align: center;
}
.qr-placeholder:active { border-color: #3B82F6; }
.form-hint {
  display: block;
  font-size: 22rpx;
  color: #94A3B8;
  padding: 8rpx 0 0;
  line-height: 1.5;
}
