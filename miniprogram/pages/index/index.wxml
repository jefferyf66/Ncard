<view class="container">
  <!-- 左侧品牌蓝装饰条 -->
  <view class="brand-stripe"></view>
  <view class="header">
    <view class="header-content">
      <view class="header-stat">
        <text class="title">我的名片</text>
        <text class="subtitle" wx:if="{{!isLoading && !isError}}">{{cards.length}} 张名片</text>
      </view>
    </view>
    <view class="header-actions">
      <text class="desktop-link" bindtap="addToDesktop">添加到桌面</text>
    </view>
  </view>

  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="error-state" wx:elif="{{isError}}">
    <view class="error-icon">
      <text>!</text>
    </view>
    <text class="error-title">加载失败</text>
    <text class="error-desc">网络开小差了，请检查网络后重试</text>
    <view class="error-btn" bindtap="retryLoad">重新加载</view>
  </view>

  <view class="empty-state" wx:elif="{{isEmpty}}">
    <view class="empty-content">
      <view class="empty-icon">
        <view class="icon-card"></view>
      </view>
      <text class="empty-title">暂无名片</text>
      <text class="empty-desc">点击按钮创建您的第一张名片</text>
      <view class="empty-btn" bindtap="goToEdit">创建名片</view>
    </view>
  </view>

  <view class="card-list" wx:else>
    <view
      wx:for="{{cards}}"
      wx:key="_id"
      class="card-item {{item._dragging ? 'dragging' : ''}}"
      style="{{item._dragOffset ? 'transform: translateY(' + item._dragOffset + 'px); z-index: 10;' : ''}}"
    >
      <!-- 拖拽句柄（≡）：拖动可调整名片顺序，仅绑定在句柄上，不干扰卡片内按钮 -->
      <view
        class="card-drag-handle"
        catchtouchstart="onCardTouchStart"
        catchtouchmove="onCardTouchMove"
        catchtouchend="onCardTouchEnd"
        data-index="{{index}}"
      >
        <view class="drag-icon"></view>
        <view class="drag-icon"></view>
      </view>
      <!-- 优化后卡片布局：参考设计稿 -->
      <view class="card-wrapper">
        <view class="card-top">
          <view class="card-avatar-wrapper">
            <image
              class="card-avatar"
              src="{{item.avatar || '../../images/avatar.png'}}"
              mode="aspectFill"
              lazy-load
              binderror="onAvatarError"
              data-index="{{index}}"
            ></image>
          </view>
          <view class="card-header-info">
            <text class="card-name">{{item.name || '未命名'}}</text>
            <text class="card-position" wx:if="{{item.position}}">{{item.position}}</text>
          </view>
        </view>
        <view class="card-divider"></view>
        <view class="card-body">
          <text class="card-company">{{item.company || ''}}</text>
          <view class="card-contact">
            <view class="contact-item" wx:if="{{item.phone}}">
              <text>{{item.phone}}</text>
            </view>
            <view class="contact-item" wx:if="{{item.email}}">
              <text>{{item.email}}</text>
            </view>
            <view class="contact-item" wx:if="{{item.address}}">
              <text>{{item.address}}</text>
            </view>
          </view>
        </view>
        <view class="card-footer">
          <button class="footer-btn send-card-btn" bindtap="openShareNoteSheet" data-id="{{item._id}}">
            <text class="footer-btn-text">发名片</text>
          </button>
          <view class="footer-divider"></view>
          <view class="footer-btn detail-card-btn" catchtap="goToPreview" data-id="{{item._id}}">
            <text class="footer-btn-text">名片详情</text>
          </view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{hasMore && !isLoading}}">
      <view class="load-more-content">
        <view class="load-more-spinner"></view>
        <text>加载更多...</text>
      </view>
    </view>
    <view class="no-more" wx:elif="{{!hasMore && cards.length > 0}}">
      <text>— 已加载全部 —</text>
    </view>
  </view>

  <!-- 底部协议入口 -->
  <view class="agreement-footer">
    <text class="agreement-link" bindtap="openPrivacyPolicy">隐私政策</text>
    <text class="agreement-sep">|</text>
    <text class="agreement-link" bindtap="openServiceAgreement">用户服务协议</text>
  </view>

  <!-- 分享留言填写层（sheet）：仅 showShareNoteSheet 时显示；_shareCardId 由 openShareNoteSheet 暂存，供内层 open-type="share" 按钮取用 -->
  <view class="share-note-mask" wx:if="{{showShareNoteSheet}}" bindtap="closeShareNoteSheet">
    <view class="share-note-sheet" catchtap="stopPropagation">
      <view class="share-note-title">给这次分享加句话（可选）</view>
      <textarea class="share-note-input" maxlength="40" placeholder="一句话介绍业务或留言，最多40字" value="{{shareNote}}" bindinput="onShareNoteInput" />
      <view class="share-note-count">{{shareNote.length}}/40</view>
      <view class="share-note-recent" wx:if="{{recentNotes.length}}">
        <text class="share-note-recent-label">最近用过</text>
        <scroll-view class="share-note-recent-scroll" scroll-x enable-flex>
          <view class="share-note-chip" wx:for="{{recentNotes}}" wx:key="*this" data-note="{{item}}" bindtap="onPickRecentNote">{{item}}</view>
        </scroll-view>
      </view>
      <view class="share-note-actions">
        <view class="share-note-cancel" bindtap="closeShareNoteSheet">取消</view>
        <button class="share-note-confirm" open-type="share" data-id="{{_shareCardId}}" bindtap="onShareButtonTap">分享给好友</button>
      </view>
    </view>
  </view>
</view>

<!-- 隐藏 Canvas 用于生成分享卡片（尺寸由 cardStyle 统一配置） -->
<canvas type="2d" id="shareCanvas" class="share-canvas-hidden"
  style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"></canvas>
