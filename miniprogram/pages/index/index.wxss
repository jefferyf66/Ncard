/**
 * index.wxss — 首页样式
 * ==========================================
 * 名片卡片视觉属性与 config/cardStyle.js 保持同步（单一数据源）
 * 修改卡片样式时请同步更新 cardStyle.js 中的对应常量
 */
page {
  background: linear-gradient(180deg, #EEF2FF 0%, #F5F5F5 100%);
  min-height: 100vh;
}

.container {
  padding: 0 24rpx 48rpx;
  padding-top: calc(var(--status-bar-height) + 20rpx);
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.header-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F172A;
}

.subtitle {
  font-size: 26rpx;
  color: #94A3B8;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-avatar text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0F172A;
}

.header-right {
  display: flex;
  gap: 16rpx;
}

.header-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.header-btn-icon {
  font-size: 36rpx;
  color: #64748B;
}

/* 头部按钮容器 */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 头部按钮图标包装 */
.header-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.header-icon-wrapper.small {
  width: 48rpx;
  height: 48rpx;
}

/* 桌面图标 */
.icon-desktop {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.icon-desktop::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  height: 16rpx;
  border: 3rpx solid #3B82F6;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}

.icon-desktop::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 4rpx;
  background: #3B82F6;
  border-radius: 2rpx;
}

/* 新增按钮图标包装 */
.add-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(59, 130, 246, 0.3);
}

.add-icon {
  font-size: 36rpx;
  font-weight: 400;
  color: #fff;
  line-height: 1;
}

.search-bar {
  background: rgba(255, 255, 255, 0.8);
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10px);
}

.search-icon {
  font-size: 32rpx;
  color: #94A3B8;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1E293B;
}

.card-list {
  display: flex;
  flex-direction: column;
}

.card-item {
  margin-bottom: 24rpx;
}

.card-wrapper {
  position: relative;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.card-top {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.card-avatar-wrapper {
  flex-shrink: 0;
}

.card-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: #F1F5F9;
}

.card-header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  gap: 8rpx;
}

.card-name {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
}

.card-position {
  font-size: 26rpx;
  color: #64748B;
}

.card-divider {
  height: 2rpx;
  background: rgba(0, 0, 0, 0.08);
  margin: 0 0 24rpx 0;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card-company {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
  text-align: left;
}

.card-contact {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.contact-item {
  display: flex;
  justify-content: flex-end;
  font-size: 26rpx;
  color: #475569;
}

/* 卡片底部 - 使用深色背景，两个扁平按钮等分 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx -32rpx -32rpx -32rpx;
  padding: 0;
  background: linear-gradient(135deg, #1E3A5F 0%, #2D4A6F 100%);
  border-radius: 0 0 24rpx 24rpx;
  overflow: hidden;
}

/* 底部按钮公共样式 - 扁平化设计 */
.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 96rpx;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

.footer-btn::after {
  border: none;
}

.footer-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
  text-align: center;
}

/* 发名片按钮 */
.send-card-btn .footer-btn-text {
  color: #fff;
}

/* 名片详情按钮 */
.detail-card-btn .footer-btn-text {
  color: #fff;
}

/* 按钮分隔线 - 完整分隔两个按钮 */
.footer-divider {
  width: 1rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 按钮点击反馈状态 */
.footer-btn:active {
  opacity: 0.7;
  background: rgba(255, 255, 255, 0.1);
}

.load-more {
  padding: 32rpx;
  text-align: center;
}

.load-more-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #94A3B8;
  font-size: 26rpx;
}

.load-more-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E2E8F0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.no-more {
  padding: 32rpx;
  text-align: center;
  color: #CBD5E1;
  font-size: 24rpx;
}

.visitors-section {
  margin-top: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
}

.section-arrow {
  font-size: 26rpx;
  color: #3B82F6;
}

.stats-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.stat-item:active {
  background: #F8FAFC;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #94A3B8;
}

.recent-visitors {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.visitors-list {
  display: flex;
  gap: 20rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}

.visitors-list::-webkit-scrollbar {
  display: none;
}

/* 访客列表样式已移至底部 .visitor-list 区块 */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #E0F2FE 0%, #FEF3C7 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon text {
  font-size: 64rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94A3B8;
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  background: #FEF2F2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.error-icon text {
  font-size: 48rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #DC2626;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: 26rpx;
  color: #94A3B8;
  text-align: center;
  margin-bottom: 32rpx;
}

.error-btn {
  background: #fff;
  color: #3B82F6;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  border: 2rpx solid #3B82F6;
}

.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  height: 88rpx;
  padding: 0 40rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
  z-index: 100;
}

.add-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
  white-space: nowrap;
}

.hidden-canvas {
  position: fixed;
  top: -1000px;
  left: -1000px;
  width: 1px;
  height: 1px;
  opacity: 0;
}

/* 分享卡片 Canvas（尺寸由 cardStyle 统一配置，数据绑定动态设置） */
.share-canvas-hidden {
  position: fixed;
  top: 0;
  left: 0;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}

/* ============ 加载态 ============ */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E2E8F0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #94A3B8;
}

/* ============ 空状态内容 ============ */
.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* ============ 图标 — 纯 CSS 实现 ============ */
.icon-card {
  width: 56rpx;
  height: 40rpx;
  border: 3rpx solid #94A3B8;
  border-radius: 6rpx;
  position: relative;
  opacity: 0.5;
}

.icon-card::after {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 8rpx;
  right: 8rpx;
  height: 3rpx;
  background: #94A3B8;
  box-shadow: 0 8rpx 0 #94A3B8;
}

.icon-users {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.icon-users::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #3B82F6;
  border-radius: 50%;
}

.icon-users::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 4rpx;
  right: 4rpx;
  height: 20rpx;
  border: 3rpx solid #3B82F6;
  border-radius: 10rpx 10rpx 0 0;
}

.icon-eye {
  width: 44rpx;
  height: 28rpx;
  position: relative;
}

.icon-eye::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 44rpx;
  height: 22rpx;
  border: 3rpx solid #3B82F6;
  border-radius: 50%;
}

.icon-eye::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 14rpx;
  background: #3B82F6;
  border-radius: 50%;
}

.icon-add {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-add::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 36rpx;
  height: 4rpx;
  background: #3B82F6;
  border-radius: 2rpx;
}

.icon-add::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 4rpx;
  height: 36rpx;
  background: #3B82F6;
  border-radius: 2rpx;
}

.icon-user {
  width: 44rpx;
  height: 52rpx;
  position: relative;
}

.icon-user::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
}

.icon-user::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 28rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 14rpx 14rpx 0 0;
}

/* ============ 统计卡片分隔线 ============ */
.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #E2E8F0;
  align-self: center;
}

/* ============ 访客列表（首页精简版） ============ */
.visitor-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.visitor-item {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.03), 0 1rpx 3rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid #E2E8F0;
}

.visitor-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
}

.visitor-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.visitor-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.visitor-level-badge {
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.visitor-level-badge.level-1 {
  background: #F1F5F9;
  color: #94A3B8;
  border: 1rpx solid #E2E8F0;
}

.visitor-level-badge.level-2 {
  background: rgba(59, 130, 246, 0.06);
  color: #3B82F6;
  border: 1rpx solid rgba(59, 130, 246, 0.12);
}

.visitor-level-badge.level-3 {
  background: rgba(16, 185, 129, 0.06);
  color: #10B981;
  border: 1rpx solid rgba(16, 185, 129, 0.12);
}

.visitor-time {
  font-size: 22rpx;
  color: #94A3B8;
  margin-left: auto;
  flex-shrink: 0;
}

.visitor-position {
  font-size: 26rpx;
  color: #3B82F6;
  font-weight: 500;
}

.visitor-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #64748B;
  padding: 4rpx 14rpx;
  background: #F1F5F9;
  border-radius: 4rpx;
}

.visit-count-tag {
  color: #3B82F6;
  background: rgba(59, 130, 246, 0.06);
  font-weight: 500;
}

/* ============ 查看全部按钮 ============ */
.view-all-btn {
  text-align: center;
  padding: 32rpx;
  color: #94A3B8;
  font-size: 28rpx;
}

/* ============ 底部协议入口 ============ */
.agreement-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx 0 24rpx;
}

.agreement-link {
  font-size: 24rpx;
  color: #94A3B8;
}

.agreement-sep {
  font-size: 24rpx;
  color: #CBD5E1;
}