/**
 * index.wxss — 首页样式
 * ==========================================
 * 名片卡片视觉属性与 config/cardStyle.js 保持同步（单一数据源）
 * 修改卡片样式时请同步更新 cardStyle.js 中的对应常量
 */
page {
  background: #FFFFFF;
  min-height: 100vh;
}

.brand-stripe {
  position: fixed;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100vh;
  background: linear-gradient(180deg, #3B82F6 0%, #2563EB 100%);
  z-index: 1;
}

.container {
  padding: 20rpx 24rpx 160rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.header-stat {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.desktop-link {
  font-size: 24rpx;
  color: #3B82F6;
  padding: 24rpx 16rpx;
  margin: -24rpx -16rpx;
  display: inline-block;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F172A;
}

.subtitle {
  font-size: 26rpx;
  color: #64748B;
}

/* 头部按钮容器 */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 头部按钮旧样式已移除：添加到桌面 改用文字入口（见 .desktop-link），我的团队入口已移至底部固定栏 */

.card-list {
  display: flex;
  flex-direction: column;
}

.card-item {
  position: relative;
  margin-bottom: 24rpx;
  transition: transform 0.18s ease;
}

/* 拖拽中的卡片：轻微抬升 + 阴影，提示正在移动 */
.card-item.dragging {
  z-index: 10;
  transition: none;
}

/* 拖拽句柄（≡）：绝对定位在卡片右侧中部，仅绑定 touch 事件 */
.card-drag-handle {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 5;
}

.card-drag-handle .drag-icon {
  width: 36rpx;
  height: 4rpx;
  background: #CBD5E1;
  border-radius: 2rpx;
}

.card-drag-handle:active .drag-icon {
  background: #3B82F6;
}

.card-wrapper {
  position: relative;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.card-top {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.card-avatar-wrapper {
  flex-shrink: 0;
}

.card-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 4rpx;
  background: #F1F5F9;
}

.card-header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 8rpx;
}

.card-name {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #1E293B;
}

.card-position {
  font-size: 26rpx;
  color: #64748B;
}

.card-divider {
  height: 2rpx;
  background: rgba(0, 0, 0, 0.08);
  margin: 0 0 24rpx 0;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card-company {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
  text-align: left;
}

.card-contact {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.contact-item {
  display: flex;
  justify-content: flex-start;
  font-size: 26rpx;
  color: #475569;
}

/* 卡片底部 - 使用深色背景，两个扁平按钮等分 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx -32rpx -32rpx -32rpx;
  padding: 0;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  overflow: hidden;
}

/* 底部按钮公共样式 - 扁平化设计 */
.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 96rpx;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

.footer-btn::after {
  border: none;
}

.footer-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
  text-align: center;
}

/* 发名片按钮 */
.send-card-btn .footer-btn-text {
  color: #fff;
}

/* 名片详情按钮 */
.detail-card-btn .footer-btn-text {
  color: #fff;
}

/* 按钮分隔线 - 完整分隔两个按钮 */
.footer-divider {
  width: 1rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 按钮点击反馈状态 */
.footer-btn:active {
  opacity: 0.7;
  background: rgba(255, 255, 255, 0.1);
}

.load-more {
  padding: 32rpx;
  text-align: center;
}

.load-more-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #94A3B8;
  font-size: 26rpx;
}

.load-more-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E2E8F0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.no-more {
  padding: 32rpx;
  text-align: center;
  color: #CBD5E1;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #E0F2FE 0%, #FEF3C7 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #64748B;
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 56rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.2);
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  background: #FEF2F2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.error-icon text {
  font-size: 48rpx;
  color: #DC2626;
  font-weight: 700;
}

.error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #DC2626;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: 26rpx;
  color: #64748B;
  text-align: center;
  margin-bottom: 32rpx;
}

.error-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #3B82F6;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 56rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid #3B82F6;
}

/* 分享卡片 Canvas（尺寸由 cardStyle 统一配置，数据绑定动态设置） */
.share-canvas-hidden {
  position: fixed;
  top: 0;
  left: 0;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}

/* ============ 加载态 ============ */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-state .loading-spinner {
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #64748B;
}

/* ============ 空状态内容 ============ */
.empty-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* ============ 图标 — 纯 CSS 实现 ============ */
.icon-card {
  width: 56rpx;
  height: 40rpx;
  border: 3rpx solid #94A3B8;
  border-radius: 6rpx;
  position: relative;
  opacity: 0.5;
}

.icon-card::after {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 8rpx;
  right: 8rpx;
  height: 3rpx;
  background: #94A3B8;
  box-shadow: 0 8rpx 0 #94A3B8;
}

/* 以下 icon-users/icon-eye/icon-add/icon-user 随首页访客模块移除已清理，仅保留 .icon-card 供空态使用 */

/* ============ 底部协议入口 ============ */
.agreement-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx 0 24rpx;
}

.agreement-link {
  font-size: 24rpx;
  color: #64748B;
  padding: 24rpx 16rpx;
  margin: -24rpx 0;
  display: inline-block;
}

.agreement-sep {
  font-size: 24rpx;
  color: #CBD5E1;
}

