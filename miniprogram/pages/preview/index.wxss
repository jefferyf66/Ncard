.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.card-preview {
  margin-bottom: 32rpx;
}

.card-content {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 40rpx;
  padding-left: 48rpx;
  box-shadow: 0 2rpx 24rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(29, 78, 216, 0.03);
  border: 2rpx solid rgba(29, 78, 216, 0.06);
  position: relative;
}

/* 左侧品牌色装饰条 */
.card-content::before {
  content: '';
  position: absolute;
  top: 32rpx;
  bottom: 32rpx;
  left: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #3B82F6 0%, #60A5FA 50%, #3B82F6 100%);
  border-radius: 0 3rpx 3rpx 0;
}

.card-top {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 4rpx;
  border: 3rpx solid rgba(59, 130, 246, 0.15);
  background: linear-gradient(135deg, #EFF6FF 0%, #F8FAFC 100%);
}

.name-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 44rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: 3rpx;
  font-family: Georgia, 'Times New Roman', 'PingFang SC', serif;
}

.position {
  font-size: 26rpx;
  color: #3B82F6;
  padding: 8rpx 20rpx;
  background: rgba(59, 130, 246, 0.06);
  border-radius: var(--radius-sm);
  align-self: flex-start;
  font-weight: 500;
}

.card-divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #E2E8F0 20%, #E2E8F0 80%, transparent 100%);
  margin: 0 -40rpx 28rpx;
}

.company {
  font-size: 30rpx;
  color: #334155;
  font-weight: 500;
  margin-bottom: 28rpx;
  display: block;
  font-family: Georgia, 'Times New Roman', 'PingFang SC', serif;
}

.contact-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: var(--radius-sm);
  border-left: 4rpx solid transparent;
  transition: all 0.2s;
}

.contact-row:active {
  background: linear-gradient(135deg, #EFF6FF 0%, #F1F5F9 100%);
  border-left-color: #3B82F6;
}

.contact-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.save-contact-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 20rpx 0;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.28);
}

.save-contact-btn-active {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
}

.save-contact-icon {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  flex-shrink: 0;
}

.save-contact-icon::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  transform: translate(-50%, -50%);
  border: 3rpx solid #FFFFFF;
  border-radius: 50%;
}

.save-contact-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 3rpx;
  height: 16rpx;
  transform: translate(-50%, -50%);
  background: #FFFFFF;
}

.save-contact-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.icon-phone {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
  position: relative;
}

.icon-phone::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  right: 10rpx;
  height: 2rpx;
  background: #3B82F6;
}

.icon-phone::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 12rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 0 0 10rpx 10rpx;
  border-top: none;
}

.icon-mail {
  width: 40rpx;
  height: 32rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 6rpx;
  position: relative;
}

.icon-mail::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 10rpx solid #3B82F6;
}

.icon-map {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.icon-map::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
}

.icon-map::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
  background: #3B82F6;
}

.contact-text {
  font-size: 28rpx;
  color: #334155;
  text-align: left;
  flex: 1;
}

.section-card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid #F1F5F9;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #F1F5F9;
}

.section-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(59, 130, 246, 0.06);
  border-radius: var(--radius-sm);
}

.section-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
  font-family: Georgia, 'Times New Roman', 'PingFang SC', serif;
}

.section-count {
  font-size: 26rpx;
  color: #3B82F6;
  background: rgba(59, 130, 246, 0.06);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.icon-briefcase {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #3B82F6;
  border-radius: var(--radius-sm);
  position: relative;
}

.icon-briefcase::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 6rpx;
  right: 6rpx;
  height: 4rpx;
  background: #3B82F6;
}

.icon-paperclip {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.icon-paperclip::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #3B82F6;
  border-right: none;
  border-bottom: none;
  border-radius: 4rpx 0 0 0;
}

.icon-paperclip::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 4rpx;
  right: 4rpx;
  height: 4rpx;
  background: #3B82F6;
}

.icon-file {
  width: 44rpx;
  height: 52rpx;
  border: 2rpx solid #3B82F6;
  border-radius: var(--radius-sm);
  position: relative;
}

.icon-file::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #3B82F6;
  border-radius: var(--radius-sm);
}

.icon-file::after {
  content: '';
  position: absolute;
  top: 34rpx;
  left: 8rpx;
  right: 8rpx;
  height: 2rpx;
  background: #3B82F6;
  box-shadow: 0 8rpx 0 #3B82F6;
}

.icon-download {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.icon-download::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid #3B82F6;
}

.icon-download::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 2rpx;
  right: 2rpx;
  height: 14rpx;
  border: 2rpx solid #3B82F6;
  border-radius: var(--radius-sm);
}

.experience-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.experience-item {
  padding: 20rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: var(--radius-sm);
  border-left: 4rpx solid transparent;
  transition: border-color 0.2s;
}

.experience-item:active {
  border-left-color: #3B82F6;
}

.exp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.exp-company {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  font-family: Georgia, 'Times New Roman', 'PingFang SC', serif;
}

.exp-period {
  font-size: 24rpx;
  color: #64748B;
}

.exp-position {
  font-size: 26rpx;
  color: #3B82F6;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.exp-desc {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
}

.intro-content {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.8;
}

.attachment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.attachment-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: var(--radius-sm);
}

.attach-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.attach-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.attach-name {
  font-size: 28rpx;
  color: #0F172A;
}

.attach-meta {
  font-size: 24rpx;
  color: #64748B;
}

.attach-action {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.link-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #F8FAFC 0%, #F1F5F9 100%);
  border-radius: var(--radius-md);
  border-left: 6rpx solid #3B82F6;
}

.link-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.link-icon-wrap.website {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
}

.icon-wechat {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 10rpx;
  position: relative;
}

.icon-wechat::before,
.icon-wechat::after {
  content: '';
  position: absolute;
  background: #FFFFFF;
  border-radius: 50%;
}

.icon-wechat::before {
  width: 14rpx;
  height: 14rpx;
  top: 8rpx;
  left: 8rpx;
}

.icon-wechat::after {
  width: 18rpx;
  height: 18rpx;
  bottom: 8rpx;
  right: 6rpx;
}

.icon-globe {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #FFFFFF;
  border-radius: 50%;
  position: relative;
}

.icon-globe::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 2rpx;
  right: 2rpx;
  height: 2rpx;
  background: #FFFFFF;
  transform: translateY(-50%);
}

.icon-globe::after {
  content: '';
  position: absolute;
  top: 2rpx;
  bottom: 2rpx;
  left: 50%;
  width: 2rpx;
  height: auto;
  background: #FFFFFF;
  transform: translateX(-50%);
}

.link-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.link-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  font-family: Georgia, 'Times New Roman', 'PingFang SC', serif;
}

.link-desc {
  font-size: 24rpx;
  color: #64748B;
}

.link-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-arrow-right {
  width: 24rpx;
  height: 24rpx;
  border-top: 2rpx solid #3B82F6;
  border-right: 2rpx solid #3B82F6;
  transform: rotate(45deg);
}

.function-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 28rpx 0;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid #F3F4F6;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.func-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s;
  background: rgba(59, 130, 246, 0.06);
}

.func-icon-wrap:active {
  transform: scale(0.92);
}

.icon-edit {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-edit::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  right: 2rpx;
  bottom: 2rpx;
  border: 2rpx solid #3B82F6;
  border-radius: var(--radius-sm);
}

.icon-edit::after {
  content: '';
  position: absolute;
  bottom: 0;
  right: 0;
  width: 20rpx;
  height: 6rpx;
  background: #3B82F6;
  transform: rotate(-45deg);
  transform-origin: left center;
}

.icon-save {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-save::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 14rpx;
  border: 2rpx solid #3B82F6;
  border-radius: var(--radius-sm);
}

.icon-save::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 0;
  right: 0;
  height: 14rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 0 0 4rpx 4rpx;
}

.icon-trash {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}

.icon-trash::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border: 2rpx solid #EF4444;
  border-radius: var(--radius-sm);
}

.icon-trash::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 6rpx;
  background: #EF4444;
  border-radius: 2rpx;
}

.func-text {
  font-size: 26rpx;
  color: #475569;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E2E8F0;
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #64748B;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.icon-alert {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #EF4444;
  border-radius: 50%;
  position: relative;
}

.icon-alert::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 24rpx;
  background: #EF4444;
}

.error-text {
  font-size: 28rpx;
  color: #64748B;
  margin-bottom: 32rpx;
}

.retry-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 64rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #FFFFFF;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(59, 130, 246, 0.12);
}

.delete-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(8rpx);
}

.modal-content {
  width: 85%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.modal-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #6B7280;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.modal-btn {
  flex: 1;
  padding: 28rpx;
  text-align: center;
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  font-weight: 500;
  transition: transform 0.2s;
}

.modal-btn:active {
  transform: scale(0.98);
}

.modal-btn.cancel {
  background: #F1F5F9;
  color: #475569;
}

.modal-btn.confirm {
  background: #EF4444;
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.15);
}

.modal-btn.primary {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.15);
}

/* ===== P1-1 访客授权弹窗（微信原生 chooseAvatar + nickname） ===== */
.auth-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(8rpx);
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin-bottom: 16rpx;
  border: 2rpx dashed #93C5FD;
  border-radius: var(--radius-sm);
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  overflow: hidden;
}

.avatar-btn:active {
  background: #EFF6FF;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-placeholder {
  width: 72rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder .icon-user {
  width: 48rpx;
  height: 60rpx;
  position: relative;
}

.avatar-placeholder .icon-user::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #94A3B8;
  border-radius: 50%;
}

.avatar-placeholder .icon-user::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 26rpx;
  border: 3rpx solid #94A3B8;
  border-radius: 14rpx 14rpx 0 0;
  border-bottom: none;
}

.avatar-btn-text {
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.4;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: #0F172A;
  margin-bottom: 40rpx;
}

.nickname-ph {
  color: #94A3B8;
}

/* ===== P1-8 公众号二维码弹窗（原内联样式收编为类） ===== */
.qr-image {
  width: 420rpx;
  height: 420rpx;
  margin-top: 8rpx;
}

.qr-tip {
  font-size: 26rpx;
  color: #64748B;
  margin-top: 24rpx;
  text-align: center;
}

.qr-close {
  margin-top: 32rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #FFFFFF;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 600;
}

/* ============ AUTH BANNER（非阻断式底部授权引导条） ============ */
.auth-banner {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-top: 2rpx solid #F1F5F9;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 900;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  animation: bannerSlideUp 0.3s ease-out;
}

@keyframes bannerSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.auth-banner-bar {
  width: 48rpx;
  height: 6rpx;
  background: #3B82F6;
  border-radius: 3rpx;
  align-self: flex-start;
}

.auth-banner-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.auth-banner-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.auth-banner-icon .icon-user {
  width: 36rpx;
  height: 44rpx;
  position: relative;
}

.auth-banner-icon .icon-user::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
}

.auth-banner-icon .icon-user::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 22rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 11rpx 11rpx 0 0;
}

.auth-banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.auth-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
}

.auth-banner-desc {
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.5;
}

.auth-banner-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.auth-btn-dismiss {
  padding: 20rpx 40rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: #64748B;
  background: #F1F5F9;
  transition: all 0.2s;
}

.auth-btn-dismiss:active {
  background: #E2E8F0;
}

.auth-btn-agree {
  padding: 20rpx 40rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(160deg, #3B82F6 0%, #2563EB 100%);
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.18);
  transition: all 0.2s;
}

.auth-btn-agree:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.12);
}

/* ===== 团队徽章 + 团队名片视图（T12） ===== */
.team-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}
.team-badge {
  display: flex;
  align-items: center;
  background: #EFF6FF;
  border: 2rpx solid #BFDBFE;
  border-radius: var(--radius-md);
  padding: 4rpx 16rpx;
}
.badge-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #3B82F6; margin-right: 8rpx;
}
.badge-text { font-size: 24rpx; color: #2563EB; font-weight: 600; }

/* 名片页 → 团队详情直达链接 */
.team-link {
  margin-top: -16rpx;
  padding: 12rpx 0;
  display: flex;
  align-items: center;
  min-height: 88rpx;
}
.team-link:active { opacity: 0.6; }
.team-link-text {
  font-size: 24rpx;
  color: #3B82F6;
  font-weight: 500;
}

.team-card-modal {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex; align-items: center; justify-content: center; z-index: 1000;
}
.team-card-content {
  width: 84%; background: #fff; border-radius: var(--radius-lg); padding: 36rpx 36rpx 28rpx;
}
.tc-header { display: flex; flex-direction: column; align-items: center; margin-bottom: 24rpx; }
.tc-title { font-size: 34rpx; font-weight: 700; color: #0F172A; }
.tc-team { font-size: 24rpx; color: #3B82F6; margin-top: 6rpx; }
.tc-body { display: flex; flex-direction: column; gap: 16rpx; }
.tc-field { display: flex; align-items: baseline; }
.tc-label {
  width: 140rpx; flex-shrink: 0; font-size: 26rpx; color: #64748B;
}
.tc-value { flex: 1; font-size: 28rpx; color: #1F2937; font-weight: 500; word-break: break-all; }
.tc-note { margin-top: 12rpx; font-size: 24rpx; color: #64748B; line-height: 1.6; }
.tc-close {
  margin-top: 28rpx; text-align: center; font-size: 30rpx; color: #3B82F6;
  font-weight: 600; min-height: 88rpx; display: flex; align-items: center; justify-content: center;
  background: #EFF6FF; border-radius: var(--radius-md);
}

/* ============ 访客分析（详情页，按单卡维度） ============ */
.icon-eye {
  width: 44rpx;
  height: 28rpx;
  position: relative;
}
.icon-eye::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 44rpx;
  height: 22rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
}
.icon-eye::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  background: #3B82F6;
  border-radius: 50%;
}

.view-all-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #3B82F6;
  font-weight: 500;
  padding: 0 20rpx;
  margin: -20rpx -12rpx -20rpx 0;
  background: rgba(59, 130, 246, 0.06);
  border-radius: var(--radius-sm);
}
.view-all-btn:active {
  background: rgba(59, 130, 246, 0.12);
}

.analytics-stats {
  display: flex;
  align-items: center;
  padding: 4rpx 0 24rpx;
}
.analytics-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.analytics-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F172A;
  font-family: Georgia, 'Times New Roman', 'PingFang SC', serif;
}
.analytics-label {
  font-size: 24rpx;
  color: #64748B;
}
.analytics-divider {
  width: 2rpx;
  height: 56rpx;
  background: #F1F5F9;
}

.analytics-recent {
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
  border-top: 2rpx solid #F1F5F9;
}
.recent-visitor {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}
.recent-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #F1F5F9;
  display: flex;
  align-items: center;
  justify-content: center;
}
.recent-avatar-img {
  width: 100%;
  height: 100%;
}
.recent-avatar .icon-user {
  width: 32rpx;
  height: 40rpx;
  position: relative;
}
.recent-avatar .icon-user::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #94A3B8;
  border-radius: 50%;
}
.recent-avatar .icon-user::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 20rpx;
  border: 2rpx solid #94A3B8;
  border-radius: 10rpx 10rpx 0 0;
}
.recent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.recent-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.recent-name {
  font-size: 28rpx;
  color: #0F172A;
  font-weight: 500;
}
.recent-count {
  font-size: 24rpx;
  color: #64748B;
}
.recent-meta {
  font-size: 24rpx;
  color: #64748B;
}

.visitor-level-badge {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
  flex-shrink: 0;
}
.visitor-level-badge.level-1 {
  background: #F1F5F9;
  color: #94A3B8;
  border: 1rpx solid #E2E8F0;
}
.visitor-level-badge.level-2 {
  background: rgba(59, 130, 246, 0.06);
  color: #3B82F6;
  border: 1rpx solid rgba(59, 130, 246, 0.12);
}

.analytics-empty {
  padding: 24rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #64748B;
}

/* D2 锁定占位区（零样式补齐） */
.locked-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed #E2E8F0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.lock-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.lock-icon {
  width: 24rpx;
  height: 20rpx;
  border: 4rpx solid #94A3B8;
  border-radius: 4rpx;
  position: relative;
  flex-shrink: 0;
}
.lock-icon::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 12rpx;
  border: 4rpx solid #94A3B8;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
}
.lock-text {
  font-size: 24rpx;
  color: #64748B;
}
.auth-cta {
  margin-top: 8rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  border-radius: var(--radius-sm);
}

.function-item.saved .func-text { color: #3B82F6; font-weight: 600; }
