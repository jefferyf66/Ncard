<view class="container">
  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="error-state" wx:elif="{{isError}}">
    <view class="error-icon">
      <view class="icon-alert"></view>
    </view>
    <text class="error-text">{{errorMsg}}</text>
    <view class="retry-btn" bindtap="retryLoad">点击重试</view>
  </view>

  <view wx:else>
    <view class="card-preview" wx:if="{{card.name}}">
      <view class="card-content">
        <!-- 一次性分享留言横幅：仅接收方通过带 note 的分享链接进入、且非名片主人时显示 -->
        <view class="share-note-banner" wx:if="{{!isOwner && shareNote}}">
          <view class="share-note-banner-icon"></view>
          <text class="share-note-banner-text">对方留言：{{shareNote}}</text>
        </view>
        <view class="card-top">
          <image 
            class="avatar" 
            src="{{card.avatar || '../../images/avatar.png'}}" 
            mode="aspectFill"
            binderror="onAvatarError"
          ></image>
          <view class="name-area">
            <text class="name">{{card.name}}</text>
            <text class="position" wx:if="{{card.position}}">{{card.position}}</text>
            <view class="team-badges" wx:if="{{teamBadges.length}}">
              <view class="team-badge" wx:for="{{teamBadges}}" wx:key="teamId" data-index="{{index}}" bindtap="openTeamCard">
                <view class="badge-dot"></view>
                <text class="badge-text">{{item.team.name}}</text>
              </view>
            </view>
            <!-- 直达团队详情（保留上方徽章点击弹托管视图的原行为） -->
            <view class="team-link" wx:if="{{teamBadges.length}}" bindtap="goToTeamDetail" data-team-id="{{teamBadges[0].teamId}}">
              <text class="team-link-text">查看团队 ›</text>
            </view>
          </view>
        </view>
        
        <view class="card-divider"></view>
        
        <text class="company" wx:if="{{card.company}}">{{card.company}}</text>
        
        <view class="contact-section">
          <view class="contact-row" wx:if="{{card.phone}}" bindtap="handlePhone">
            <text class="contact-text">{{card.phone}}</text>
            <view class="contact-icon icon-phone"></view>
          </view>
          <view class="contact-row" wx:if="{{card.email}}" bindtap="handleEmail">
            <text class="contact-text">{{card.email}}</text>
            <view class="contact-icon icon-mail"></view>
          </view>
          <view class="contact-row" wx:if="{{card.address}}" bindtap="handleAddress">
            <text class="contact-text">{{card.address}}</text>
            <view class="contact-icon icon-map"></view>
          </view>

          <view class="save-contact-btn" wx:if="{{!isOwner && (card.name || card.phone || card.email || card.company)}}" bindtap="saveToContact" hover-class="save-contact-btn-active">
            <view class="save-contact-icon"></view>
            <text class="save-contact-text">保存到通讯录</text>
          </view>
        </view>

        <!-- D2 锁定占位区：仅非主人且存在被锁字段时展示 -->
        <view class="locked-section" wx:if="{{!isOwner && lockedFields.length > 0}}">
          <view class="lock-item" wx:for="{{lockedFields}}" wx:key="*this">
            <view class="lock-icon"></view>
            <text class="lock-text">登录后查看{{fieldLabel[item]}}</text>
          </view>
          <view class="auth-cta" bindtap="showAuthModal">登录查看完整名片</view>
        </view>
      </view>
    </view>

    <view class="section-card" wx:if="{{card.experiences && card.experiences.length > 0}}">
      <view class="section-header">
        <view class="section-icon">
          <view class="icon-briefcase"></view>
        </view>
        <text class="section-title">过往经历</text>
        <text class="section-count">{{card.experiences.length}}</text>
      </view>
      <view class="experience-list">
        <view class="experience-item" wx:for="{{card.experiences}}" wx:key="index">
          <view class="exp-header">
            <text class="exp-company">{{item.company}}</text>
            <text class="exp-period">{{item.period}}</text>
          </view>
          <text class="exp-position">{{item.position}}</text>
          <text class="exp-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="section-card" wx:if="{{card.personalIntro}}">
      <view class="section-header">
        <view class="section-icon">
          <view class="icon-user"></view>
        </view>
        <text class="section-title">个人介绍</text>
      </view>
      <text class="intro-content">{{card.personalIntro}}</text>
    </view>

    <view class="section-card" wx:if="{{card.businessIntro}}">
      <view class="section-header">
        <view class="section-icon">
          <view class="icon-briefcase"></view>
        </view>
        <text class="section-title">业务介绍</text>
      </view>
      <text class="intro-content">{{card.businessIntro}}</text>
    </view>

    <view class="section-card" wx:if="{{card.attachments && card.attachments.length > 0}}">
      <view class="section-header">
        <view class="section-icon">
          <view class="icon-paperclip"></view>
        </view>
        <text class="section-title">名片附件</text>
      </view>
      <view class="attachment-list">
        <view class="attachment-item" wx:for="{{card.attachments}}" wx:key="index" bindtap="downloadAttachment" data-url="{{item.url}}" data-name="{{item.name}}">
          <view class="attach-icon-wrap">
            <view class="icon-file"></view>
          </view>
          <view class="attach-info">
            <text class="attach-name">{{item.name}}</text>
            <text class="attach-meta">{{item.size}} · {{item.time}}</text>
          </view>
          <view class="attach-action">
            <view class="icon-download"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card" wx:if="{{card.wechatOfficial && card.wechatOfficial.name && card.wechatOfficial.qrcode}}">
      <view class="link-card" bindtap="openWechatOfficial">
        <view class="link-icon-wrap">
          <view class="icon-wechat"></view>
        </view>
        <view class="link-info">
          <text class="link-name">{{card.wechatOfficial.name}}</text>
          <text class="link-desc">点击查看二维码</text>
        </view>
        <view class="link-arrow">
          <view class="icon-arrow-right"></view>
        </view>
      </view>
    </view>

    <!-- 公众号二维码弹窗：长按识别关注 -->
    <view class="delete-modal" wx:if="{{showOfficialQR}}" bindtap="closeOfficialQR">
      <view class="modal-content" catchtap="noop">
        <image src="{{officialQRUrl}}" mode="aspectFit" show-menu-by-longpress="{{true}}" class="qr-image" />
        <text class="qr-tip">长按上方二维码，识别关注公众号</text>
        <view class="qr-close" bindtap="closeOfficialQR">关闭</view>
      </view>
    </view>

    <view class="section-card" wx:if="{{card.companyWebsite && card.companyWebsite.url}}">
      <view class="link-card" bindtap="openCompanyWebsite">
        <view class="link-icon-wrap website">
          <view class="icon-globe"></view>
        </view>
        <view class="link-info">
          <text class="link-name">{{card.companyWebsite.name || '公司主页'}}</text>
          <text class="link-desc">访问公司官网</text>
        </view>
        <view class="link-arrow">
          <view class="icon-arrow-right"></view>
        </view>
      </view>
    </view>

    <!-- 访客分析（仅名片主人可见，按本名片维度聚合） -->
    <view class="section-card" wx:if="{{isOwner}}">
      <view class="section-header">
        <view class="section-icon">
          <view class="icon-eye"></view>
        </view>
        <text class="section-title">访客分析</text>
        <view class="view-all-btn" wx:if="{{visitorStats.visitors > 0}}" bindtap="goToVisitorAnalytics">
          <text>查看全部 ›</text>
        </view>
      </view>

      <view class="analytics-stats">
        <view class="analytics-stat">
          <text class="analytics-value">{{visitorStats.visitors}}</text>
          <text class="analytics-label">总访客</text>
        </view>
        <view class="analytics-divider"></view>
        <view class="analytics-stat">
          <text class="analytics-value">{{visitorStats.viewed}}</text>
          <text class="analytics-label">重复访问</text>
        </view>
        <view class="analytics-divider"></view>
        <view class="analytics-stat">
          <text class="analytics-value">{{recentVisitors.length}}</text>
          <text class="analytics-label">最近访客</text>
        </view>
      </view>

      <view class="analytics-recent" wx:if="{{recentVisitors.length > 0}}">
        <view class="recent-visitor" wx:for="{{recentVisitors}}" wx:key="visitorOpenId">
          <view class="recent-avatar">
            <image wx:if="{{item.avatar}}" class="recent-avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
            <view class="icon-user" wx:else></view>
          </view>
          <view class="recent-info">
            <view class="recent-name-row">
              <text class="recent-name">{{item.name}}</text>
              <view class="visitor-level-badge level-{{item.visitorLevel}}" wx:if="{{item.visitorLevel < 3}}">
                <text wx:if="{{item.visitorLevel === 2}}">已授权</text>
                <text wx:else>匿名</text>
              </view>
              <text class="recent-count" wx:if="{{item.visitCount > 1}}">×{{item.visitCount}}</text>
            </view>
            <text class="recent-meta">{{item.lastVisit}}</text>
          </view>
        </view>
      </view>

      <view class="analytics-empty" wx:else>
        <text>暂无访客数据，分享名片后这里会显示访问情况</text>
      </view>
    </view>

    <view class="function-card">
      <view class="function-item" bindtap="goToEdit" wx:if="{{isOwner}}">
        <view class="func-icon-wrap">
          <view class="icon-edit"></view>
        </view>
        <text class="func-text">编辑资料</text>
      </view>
      <view class="function-item" bindtap="saveCard" wx:if="{{!isOwner && !isSaved}}">
        <view class="func-icon-wrap">
          <view class="icon-save"></view>
        </view>
        <text class="func-text">保存名片</text>
      </view>
      <view class="function-item saved" bindtap="unsaveCard" wx:if="{{!isOwner && isSaved}}">
        <view class="func-icon-wrap">
          <view class="icon-save"></view>
        </view>
        <text class="func-text">已保存</text>
      </view>
      <view class="function-item" bindtap="confirmDelete" wx:if="{{isOwner}}">
        <view class="func-icon-wrap">
          <view class="icon-trash"></view>
        </view>
        <text class="func-text">删除名片</text>
      </view>
    </view>

  </view>
</view>

<view class="delete-modal" wx:if="{{showDeleteConfirm}}" catchtap="cancelDelete">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-icon">
      <view class="icon-alert"></view>
    </view>
    <text class="modal-title">确认删除</text>
    <text class="modal-desc">删除后无法恢复，确定要删除吗？</text>
    <view class="modal-actions">
      <view class="modal-btn cancel" bindtap="cancelDelete">取消</view>
      <view class="modal-btn confirm" bindtap="deleteCard">删除</view>
    </view>
  </view>
</view>

<!-- 匿名访客授权引导条（非阻断式底部通知） -->
<view class="auth-banner" wx:if="{{showAuthBanner}}">
  <view class="auth-banner-bar"></view>
  <view class="auth-banner-body">
    <view class="auth-banner-icon">
      <view class="icon-user"></view>
    </view>
    <view class="auth-banner-text">
      <text class="auth-banner-title">访问记录为匿名状态</text>
      <text class="auth-banner-desc">授权微信昵称后，名片主人可以看到您的身份</text>
    </view>
  </view>
    <view class="auth-banner-actions">
      <view class="auth-btn-dismiss" bindtap="dismissAuthBanner">暂不</view>
      <view class="auth-btn-agree" bindtap="showAuthModal">授权</view>
    </view>
</view>

<!-- 团队名片视图（T12）：个人 card 真相源 + 托管字段覆盖层合并 -->
<view class="team-card-modal" wx:if="{{showTeamCard}}" catchtap="closeTeamCard">
  <view class="team-card-content" catchtap="stopPropagation">
    <view class="tc-header">
      <text class="tc-title">团队名片</text>
      <text class="tc-team">由「{{teamCardName}}」管理</text>
    </view>
    <view class="tc-body" wx:if="{{teamCardView}}">
      <view class="tc-field" wx:if="{{teamCardView.name}}"><text class="tc-label">姓名</text><text class="tc-value">{{teamCardView.name}}</text></view>
      <view class="tc-field" wx:if="{{teamCardView.position}}"><text class="tc-label">职位</text><text class="tc-value">{{teamCardView.position}}</text></view>
      <view class="tc-field" wx:if="{{teamCardView.company}}"><text class="tc-label">公司</text><text class="tc-value">{{teamCardView.company}}</text></view>
      <view class="tc-field" wx:if="{{teamCardView.department}}"><text class="tc-label">部门</text><text class="tc-value">{{teamCardView.department}}</text></view>
      <view class="tc-field" wx:if="{{teamCardView.phone}}"><text class="tc-label">电话</text><text class="tc-value">{{teamCardView.phone}}</text></view>
      <view class="tc-field" wx:if="{{teamCardView.address}}"><text class="tc-label">地址</text><text class="tc-value">{{teamCardView.address}}</text></view>
      <view class="tc-field" wx:if="{{teamCardView.website}}"><text class="tc-label">网址</text><text class="tc-value">{{teamCardView.website}}</text></view>
      <view class="tc-field" wx:if="{{teamCardView.email}}"><text class="tc-label">邮箱</text><text class="tc-value">{{teamCardView.email}}</text></view>
      <view class="tc-note">个人字段（姓名/私人手机/微信/私人邮箱/地址）始终以本人名片为准，不被团队覆盖。</view>
    </view>
    <view class="tc-close" bindtap="closeTeamCard">关闭</view>
  </view>
</view>

<!-- 访客授权弹窗（D1：微信原生 chooseAvatar + nickname input） -->
<view class="auth-modal" wx:if="{{showAuthModal}}" catchtap="closeAuthModal">
  <view class="modal-content" catchtap="stopPropagation">
    <text class="modal-title">登录查看完整名片</text>
    <text class="modal-desc">授权后名片主人可看到您的身份，您也能查看授权内容</text>
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{authAvatar}}" class="avatar-preview" src="{{authAvatar}}" mode="aspectFill"></image>
      <view wx:else class="avatar-placeholder"><view class="icon-user"></view></view>
      <text class="avatar-btn-text">点击选择头像</text>
    </button>
    <input
      class="nickname-input"
      type="nickname"
      placeholder="点击填写昵称"
      placeholder-class="nickname-ph"
      value="{{authNickname}}"
      bindinput="onNicknameInput"
      bind:blur="onNicknameInput"
    ></input>
    <view class="modal-actions">
      <view class="modal-btn cancel" bindtap="closeAuthModal">取消</view>
      <view class="modal-btn primary" bindtap="confirmAuth">确认授权</view>
    </view>
  </view>
</view>
