.page-container {
  padding: 24rpx;
  min-height: 100vh;
  background: linear-gradient(175deg, #FAFBFC 0%, #FEFCF9 30%, #F6F8FC 100%);
  padding-bottom: 180rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F172A;
}

.header-count {
  font-size: 26rpx;
  color: #64748B;
}

.segment {
  display: flex;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.segment-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #475569;
  padding: 14rpx 0;
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}

.segment-item.active {
  background: #3B82F6;
  color: #FFFFFF;
  font-weight: 600;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card-item {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: box-shadow 0.2s;
  position: relative;
  overflow: hidden;
}

/* 团队名片视觉三要素之一：左侧品牌蓝条 */
.card-item.is-team {
  padding-left: 24rpx;
}

.team-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #3B82F6;
}

.card-item:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 4rpx;
  background: #F1F5F9;
  border: 3rpx solid #E2E8F0;
}

/* 团队名片视觉三要素之二：头像正圆 + 品牌蓝描边（与个人锐角方形成语义区分） */
.avatar-team {
  border-radius: 50%;
  border-color: #3B82F6;
  border-width: 4rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: #0F172A;
}

.position {
  font-size: 26rpx;
  color: #3B82F6;
  padding: 4rpx 12rpx;
  background: #EFF6FF;
  border-radius: var(--radius-sm);
}

.company {
  font-size: 28rpx;
  color: #475569;
}

/* 团队名片视觉三要素之三：姓名旁团队胶囊徽章 + 部门 + 来源行 */
.team-badge {
  font-size: 24rpx;
  color: #3B82F6;
  background: #EFF6FF;
  border: 1rpx solid #3B82F6;
  border-radius: var(--radius-sm);
  padding: 2rpx 10rpx;
  white-space: nowrap;
}

.team-dept {
  font-size: 24rpx;
  color: #475569;
}

.team-source {
  font-size: 24rpx;
  color: #3B82F6;
  margin-top: 2rpx;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 4rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon-phone {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.icon-phone::before {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  right: 7rpx;
  height: 2rpx;
  background: #3B82F6;
}

.icon-phone::after {
  content: '';
  position: absolute;
  bottom: 7rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 8rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 0 0 7rpx 7rpx;
  border-top: none;
}

.icon-mail {
  width: 28rpx;
  height: 22rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 4rpx;
  position: relative;
  flex-shrink: 0;
}

.icon-mail::before {
  content: '';
  position: absolute;
  top: -7rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 7rpx solid #3B82F6;
}

.contact-text {
  font-size: 24rpx;
  color: #64748B;
}

.card-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow {
  font-size: 48rpx;
  color: #CBD5E1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: #F1F5F9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.icon-card {
  width: 64rpx;
  height: 46rpx;
  border: 3rpx solid #94A3B8;
  border-radius: 6rpx;
  position: relative;
  opacity: 0.5;
}

.icon-card::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 10rpx;
  right: 10rpx;
  height: 3rpx;
  background: #94A3B8;
  box-shadow: 0 9rpx 0 #94A3B8;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #0F172A;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #64748B;
  text-align: center;
}