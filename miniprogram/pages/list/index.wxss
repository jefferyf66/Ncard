.page-container {
  padding: 24rpx;
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 180rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2329;
}

.header-count {
  font-size: 26rpx;
  color: #8F959E;
}

.segment {
  display: flex;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.segment-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #646A73;
  padding: 14rpx 0;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.segment-item.active {
  background: #3B82F6;
  color: #FFFFFF;
  font-weight: 600;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: box-shadow 0.2s;
  position: relative;
  overflow: hidden;
}

/* 团队名片视觉三要素之一：左侧品牌蓝条 */
.card-item.is-team {
  padding-left: 24rpx;
}

.team-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #3B82F6;
}

.card-item:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #F0F2F5;
  border: 3rpx solid #E5E6EB;
}

/* 团队名片视觉三要素之二：头像品牌蓝描边 */
.avatar-team {
  border-color: #3B82F6;
  border-width: 4rpx;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2329;
}

.position {
  font-size: 26rpx;
  color: #3B82F6;
  padding: 4rpx 12rpx;
  background: #EFF6FF;
  border-radius: 8rpx;
}

.company {
  font-size: 28rpx;
  color: #646A73;
}

/* 团队名片视觉三要素之三：姓名旁团队胶囊徽章 + 部门 + 来源行 */
.team-badge {
  font-size: 22rpx;
  color: #3B82F6;
  background: #EFF6FF;
  border: 1rpx solid #3B82F6;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  white-space: nowrap;
}

.team-dept {
  font-size: 24rpx;
  color: #646A73;
}

.team-source {
  font-size: 22rpx;
  color: #3B82F6;
  margin-top: 2rpx;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 4rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.contact-icon {
  font-size: 24rpx;
}

.contact-text {
  font-size: 24rpx;
  color: #8F959E;
}

.card-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow {
  font-size: 48rpx;
  color: #BBBFC4;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: #F0F2F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.icon-text {
  font-size: 72rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #1F2329;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8F959E;
  text-align: center;
}