<view class="page-container">
  <view class="header">
    <view class="header-title">名片夹</view>
    <view class="header-count">{{shownCards.length}} 张名片</view>
  </view>

  <view class="segment">
    <view class="segment-item {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部</view>
    <view class="segment-item {{filter === 'personal' ? 'active' : ''}}" bindtap="setFilter" data-filter="personal">个人</view>
    <view class="segment-item {{filter === 'team' ? 'active' : ''}}" bindtap="setFilter" data-filter="team">团队</view>
  </view>

  <view class="card-list">
    <view 
      wx:for="{{shownCards}}" 
      wx:key="_id" 
      class="card-item {{item.isTeam ? 'is-team' : ''}}"
      bindtap="goToCard"
      data-id="{{item._id}}"
    >
      <view wx:if="{{item.isTeam}}" class="team-bar"></view>
      <image class="avatar {{item.isTeam ? 'avatar-team' : ''}}" src="{{item.avatar || '../../images/avatar.png'}}" mode="aspectFill" binderror="onAvatarError" data-index="{{index}}"></image>
      <view class="card-info">
        <view class="name-row">
          <text class="name">{{item.name || '未填写'}}</text>
          <text class="position" wx:if="{{item.position}}">{{item.position}}</text>
          <view wx:if="{{item.isTeam && item.teams[0]}}" class="team-badge">{{item.teams[0].teamName}}</view>
        </view>
        <text class="company">{{item.company || ''}}</text>
        <text wx:if="{{item.isTeam && item.teams[0].org.department}}" class="team-dept">{{item.teams[0].org.department}}</text>
        <view class="contact-info">
          <view class="contact-item" wx:if="{{item.phone}}">
            <text class="contact-icon">📞</text>
            <text class="contact-text">{{item.phone}}</text>
          </view>
          <view class="contact-item" wx:if="{{item.email}}">
            <text class="contact-icon">✉️</text>
            <text class="contact-text">{{item.email}}</text>
          </view>
        </view>
        <text wx:if="{{item.isTeam && item.teams[0]}}" class="team-source">来自「{{item.teams[0].teamName}}」· 组织身份由团队托管</text>
      </view>
      <view class="card-arrow">
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{shownCards.length === 0}}" class="empty-state">
    <view class="empty-icon">
      <text class="icon-text">👔</text>
    </view>
    <text class="empty-title">暂无名片</text>
    <text class="empty-desc">暂未保存他人名片，在预览页保存后即可在此查看</text>
  </view>
</view>