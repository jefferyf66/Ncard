/* ==========================================
   Ncard 访客页 · 品牌蓝设计系统
   ========================================== */

.container {
  min-height: 100vh;
  padding: 24rpx;
  background: #FFFFFF;
}

/* ============ SECTION HEADER ============ */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0 24rpx;
}

.section-title {
  font-family: Georgia, 'Times New Roman', 'PingFang SC', serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
}

.section-title-row {
  padding: 24rpx 0 16rpx;
  margin-top: 16rpx;
}

/* ============ STATS CARD ============ */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #FFFFFF;
  border-radius: var(--radius-sm);
  padding: 40rpx 0;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.03), 0 1rpx 3rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid #E2E8F0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 48rpx;
  font-weight: 700;
  color: #0F172A;
}

.stat-label {
  font-size: 24rpx;
  color: #64748B;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #E2E8F0;
}

/* ============ 空状态 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F1F5F9 0%, #E2E8F0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.icon-users-empty {
  width: 70rpx;
  height: 70rpx;
  position: relative;
  opacity: 0.4;
}

.icon-users-empty::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #94A3B8;
  border-radius: 50%;
}

.icon-users-empty::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 34rpx;
  border: 2rpx solid #94A3B8;
  border-radius: 17rpx 17rpx 0 0;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
  max-width: 400rpx;
  padding: 20rpx;
  margin: -20rpx;
}

/* ============ 加载态 ============ */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-state .loading-spinner {
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #64748B;
}

/* ============ VISITOR LIST ============ */
.visitor-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.visitor-item {
  display: flex;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: var(--radius-sm);
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.03), 0 1rpx 3rpx rgba(0, 0, 0, 0.03);
  border: 2rpx solid #E2E8F0;
  transition: all 0.2s ease;
}

.visitor-item:active {
  transform: scale(0.985);
  border-color: #CBD5E1;
}

/* 访客头像 — 品牌蓝渐变背景 */
.visitor-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.visitor-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 4rpx;
}

.icon-user {
  width: 44rpx;
  height: 52rpx;
  position: relative;
}

.icon-user::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 50%;
}

.icon-user::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 28rpx;
  border: 2rpx solid #3B82F6;
  border-radius: 14rpx 14rpx 0 0;
}

.visitor-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.visitor-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 访客等级徽章 */
.visitor-level-badge {
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.visitor-level-badge.level-1 {
  background: #F1F5F9;
  color: #94A3B8;
  border: 1rpx solid #E2E8F0;
}

.visitor-level-badge.level-2 {
  background: rgba(59, 130, 246, 0.06);
  color: #3B82F6;
  border: 1rpx solid rgba(59, 130, 246, 0.12);
}

.visitor-name {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
}

.visitor-position {
  font-size: 26rpx;
  color: #3B82F6;
  font-weight: 500;
}

.visitor-company {
  font-size: 26rpx;
  color: #64748B;
}

.visitor-note {
  font-size: 26rpx;
  color: #1E293B;
  background: #EFF6FF;
  border-radius: var(--radius-sm);
  padding: 6rpx 16rpx;
  align-self: flex-start;
}

.visitor-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 24rpx;
  color: #64748B;
  padding: 4rpx 14rpx;
  background: #F1F5F9;
  border-radius: var(--radius-sm);
}

.visit-count-tag {
  color: #3B82F6;
  background: rgba(59, 130, 246, 0.06);
  font-weight: 500;
}

.visitor-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 8rpx;
}

.visitor-time {
  font-size: 24rpx;
  color: #64748B;
}

.visitor-desc {
  font-size: 24rpx;
  color: #64748B;
}

/* 访客项中的名片名：可点击跳转至该名片详情（全局视图） */
.visitor-card-link {
  color: #3B82F6;
  text-decoration: underline;
}

/* ============ 单卡模式头部 ============ */
.header-title-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.card-context {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 400;
}

.back-global {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #3B82F6;
  font-weight: 500;
  padding: 0 20rpx;
  margin: -20rpx 0;
  background: rgba(59, 130, 246, 0.06);
  border-radius: var(--radius-sm);
}

.back-global:active {
  background: rgba(59, 130, 246, 0.12);
}
