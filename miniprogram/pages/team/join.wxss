/* 加入团队 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  background: #FFFFFF;
}
.header { padding: 16rpx 8rpx 24rpx; }
.header-title { font-size: 44rpx; font-weight: 700; color: #0F172A; }
.header-sub { display: block; margin-top: 8rpx; font-size: 26rpx; color: #64748B; }

.form-card {
  background: #fff; border-radius: var(--radius-md); padding: 12rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.04); border: 2rpx solid #E2E8F0;
}
.form-group { padding: 24rpx 0; }
.form-label { font-size: 28rpx; font-weight: 600; color: #334155; }
.code-input {
  margin-top: 16rpx; height: 96rpx; background: #F8FAFC; border: 2rpx solid #E2E8F0;
  border-radius: var(--radius-sm); padding: 0 24rpx; font-size: 40rpx; font-weight: 700;
  letter-spacing: 8rpx; color: #1F2937; text-align: center;
}

.bottom-actions { position: fixed; left: 24rpx; right: 24rpx; bottom: 28rpx; }
.primary-btn {
  min-height: 88rpx; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); color: #fff;
  font-size: 30rpx; font-weight: 600; padding: 0 24rpx; border-radius: var(--radius-md);
}
.primary-btn.disabled { opacity: 0.6; }

/* 空名片填空表单 */
.cardform-card { margin-bottom: 24rpx; }
.cardform-tip {
  font-size: 24rpx; color: #64748B; line-height: 1.6; background: #EFF6FF;
  border: 2rpx solid #BFDBFE; border-radius: var(--radius-sm); padding: 18rpx 22rpx; margin-bottom: 20rpx;
}
/* P1-2 失效/已使用警告语义：红色警示条 */
.cardform-tip.warn {
  background: #FEF2F2; border-color: #FECACA; color: #DC2626;
}
.req-star { color: #EF4444; font-weight: 700; }

/* cardSchema 表单输入框（零样式补齐，对齐 create 页规格） */
.form-input {
  height: 80rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #0F172A;
}
