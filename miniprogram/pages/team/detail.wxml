<view class="container">
  <view class="loading-state" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- ============ 公开目录模式（成员/外部均可只读浏览） ============ -->
  <block wx:elif="{{viewMode === 'public'}}">
    <view class="team-header">
      <view class="team-logo">{{pubTeam.name[0]}}</view>
      <view class="team-head-info">
        <text class="team-name">{{pubTeam.name}}</text>
        <text class="team-meta">团队ID：{{pubTeam.shortId}} · {{pubTeam.memberCount}} 人</text>
      </view>
    </view>

    <view class="card-block" wx:if="{{pubTeam.description}}">
      <text class="block-text">{{pubTeam.description}}</text>
    </view>

    <!-- 成员目录网格（只读，无编辑/移除/退出/解散） -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">成员目录（{{pubMembers.length}}）</text>
      </view>
      <view class="member-grid">
        <view class="member-card" wx:for="{{pubMembers}}" wx:key="memberId">
          <image wx:if="{{item.avatarUrl}}" class="member-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="member-avatar-img">{{item.name[0]}}</view>
          <view class="member-card-name">{{item.name}}</view>
          <view class="member-card-sub">{{item.position}}{{item.company ? ' · ' + item.company : ''}}{{item.department ? ' · ' + item.department : ''}}</view>
        </view>
      </view>
      <view class="empty-members" wx:if="{{pubMembers.length === 0}}">暂无成员</view>
    </view>

    <!-- owner 可见：分享团队目录 -->
    <view class="share-dir-card" wx:if="{{isOwner}}">
      <button class="share-dir-btn" open-type="share" data-share="directory">分享团队目录</button>
    </view>
  </block>

  <!-- ============ 白名单模式（非成员 + 团队未公开目录） ============ -->
  <block wx:elif="{{viewMode === 'whitelist'}}">
    <view class="team-header">
      <view class="team-logo">{{team.name[0]}}</view>
      <view class="team-head-info">
        <text class="team-name">{{team.name}}</text>
        <text class="team-meta">团队ID：{{team.shortId}} · {{team.memberCount}} 人</text>
      </view>
    </view>

    <view class="card-block" wx:if="{{team.description}}">
      <text class="block-text">{{team.description}}</text>
    </view>

    <view class="card-block whitelist-tip">
      <view class="block-action">
        <view class="action-icon"><view class="icon-lock"></view></view>
        <view class="action-text">
          <text class="action-title">该团队未公开成员目录</text>
          <text class="action-sub">如需加入，请向团队成员获取邀请码</text>
        </view>
      </view>
      <view class="join-cta" bindtap="goTeamList">用邀请码加入 ›</view>
    </view>
  </block>

  <!-- ============ 管理模式（成员 / owner） ============ -->
  <block wx:elif="{{viewMode === 'manage'}}">
    <!-- 团队头部 -->
    <view class="team-header">
      <view class="team-logo">{{team.name[0]}}</view>
      <view class="team-head-info">
        <text class="team-name">{{team.name}}</text>
        <text class="team-meta">团队ID：{{team.shortId}} · {{team.memberCount}} 人</text>
      </view>
      <view class="role-tag {{isOwner ? 'owner' : 'member'}}">{{isOwner ? '创始人' : '成员'}}</view>
    </view>

    <view class="card-block" wx:if="{{team.description}}">
      <text class="block-text">{{team.description}}</text>
    </view>

    <!-- 邀请入口（owner） -->
    <view class="card-block" wx:if="{{isOwner}}">
      <view class="block-action" bindtap="onInvite">
        <view class="action-icon"><view class="icon-invite"></view></view>
        <view class="action-text">
          <text class="action-title">邀请成员</text>
          <text class="action-sub">生成邀请码 / 分享邀请卡片</text>
        </view>
        <text class="action-arrow">›</text>
      </view>
    </view>

    <!-- 团队名片配置（owner） -->
    <view class="card-block" wx:if="{{isOwner}}">
      <view class="block-action" bindtap="onConfigureCard">
        <view class="action-icon"><view class="icon-card"></view></view>
        <view class="action-text">
          <text class="action-title">团队名片配置</text>
          <text class="action-sub">选择显示字段 / 预填内容 / 邀请成员填写名片</text>
        </view>
        <text class="action-arrow">›</text>
      </view>
      <view class="share-actions" wx:if="{{cardConfigSchema.length}}">
        <view class="share-card-btn" bindtap="onShareCard">邀请成员填写名片</view>
      </view>
    </view>

    <!-- 设置（owner）：目录公开开关 -->
    <view class="settings-card" wx:if="{{isOwner}}">
      <view class="settings-row">
        <view class="settings-text">
          <text class="settings-title">公开成员目录</text>
          <text class="settings-sub">开启后，任何人凭链接/二维码可见团队名片</text>
        </view>
        <switch class="settings-switch" checked="{{allowDirectoryShare}}" bindchange="toggleShare" color="#3B82F6" />
      </view>
      <view class="share-dir-card" wx:if="{{allowDirectoryShare}}">
        <button class="share-dir-btn" open-type="share" data-share="directory">分享团队目录</button>
      </view>
    </view>

    <!-- 成员列表 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">成员（{{members.length}}）</text>
      </view>
      <view class="member-item" wx:for="{{members}}" wx:key="_id" bindtap="openMemberCard" data-id="{{item.cardId}}">
        <view class="member-avatar">{{item.isMe ? '我' : item.maskedId[2]}}</view>
        <view class="member-info">
          <view class="member-name-row">
            <text class="member-name">{{item.isMe ? '我' : item.maskedId}}</text>
            <view class="role-badge {{item.role === 'owner' ? 'role-owner' : 'role-member'}}">
              {{item.role === 'owner' ? '创始人' : '成员'}}
            </view>
          </view>
        </view>
        <view class="member-actions" wx:if="{{isOwner && !item.isMe}}">
          <text class="act-edit" catchtap="editMember" data-id="{{item.memberOpenId}}">编辑</text>
          <text class="act-remove" catchtap="removeMember" data-id="{{item.memberOpenId}}">移除</text>
        </view>
      </view>
      <view class="empty-members" wx:if="{{members.length === 0}}">暂无成员</view>
    </view>

    <!-- 退出（成员，非 owner） -->
    <view class="bottom-actions" wx:if="{{!isOwner}}">
      <view class="danger-btn" bindtap="onLeave">退出团队</view>
    </view>
    <view class="owner-actions" wx:if="{{isOwner}}">
      <text class="owner-tip-text">你是团队创始人，不可直接退出。解散后团队将永久删除且不可恢复。</text>
      <view class="danger-btn" bindtap="onDisband">解散团队</view>
    </view>
  </block>

  <!-- 邀请弹窗 -->
  <view class="modal-overlay" wx:if="{{showInviteModal}}" catchtap="closeInvite">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">邀请成员</view>
      <view class="code-box">
        <text class="code-label">邀请码</text>
        <text class="code-value">{{inviteCode}}</text>
        <view class="copy-btn" bindtap="copyInviteCode">复制</view>
      </view>
      <text class="modal-tip">把邀请码发给好友，或点击下方按钮分享邀请卡片。</text>
      <button class="share-btn" open-type="share" data-share="invite">分享邀请卡片</button>
      <view class="modal-close" bindtap="closeInvite">关闭</view>
    </view>
  </view>

  <!-- 团队名片配置弹层 -->
  <view class="modal-overlay" wx:if="{{showCardConfig}}" catchtap="closeCardConfig">
    <view class="modal-content config-modal" catchtap="stopPropagation">
      <view class="modal-title">团队名片配置</view>
      <text class="modal-tip">勾选「显示」控制该字段在团队名片上出现；「必填」成员须补全；预填内容会自动带入空名片。</text>
      <scroll-view scroll-y class="schema-scroll">
        <view class="schema-row" wx:for="{{cardConfigDraft}}" wx:key="key">
          <view class="schema-main">
            <text class="schema-label">{{item.label}}</text>
            <input class="schema-default" placeholder="预填内容（可选）" value="{{item.defaultValue}}" data-index="{{index}}" bindinput="onSchemaDefaultInput" maxlength="100" />
          </view>
          <view class="schema-toggles">
            <view class="schema-toggle {{item.visible ? 'on' : ''}}" data-index="{{index}}" bindtap="toggleSchemaVisible">显示</view>
            <view class="schema-toggle {{item.required ? 'on req' : ''}}" data-index="{{index}}" bindtap="toggleSchemaRequired">必填</view>
          </view>
        </view>
      </scroll-view>
      <button class="save-btn" bindtap="saveCardSchema">保存配置</button>
      <view class="modal-close" bindtap="closeCardConfig">关闭</view>
    </view>
  </view>

  <!-- 空名片邀请弹窗 -->
  <view class="modal-overlay" wx:if="{{showCardInviteModal}}" catchtap="closeCardInvite">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">邀请成员填写名片</view>
      <text class="modal-tip">把这张待填写的团队名片转发给成员，对方补全必填项后即加入团队。</text>
      <button class="share-btn" open-type="share" data-share="card">邀请成员填写名片</button>
      <view class="modal-close" bindtap="closeCardInvite">关闭</view>
    </view>
  </view>
</view>
