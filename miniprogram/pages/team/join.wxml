<view class="container">
  <view class="header">
    <text class="header-title">{{isCardInvite ? '填写团队名片' : '加入团队'}}</text>
    <text class="header-sub">{{isCardInvite ? '补全信息后加入「' + teamName + '」' : '输入邀请码加入团队'}}</text>
  </view>

  <!-- 邀请已失效 / 已使用 -->
  <view wx:if="{{inviteInvalid}}" class="cardform-tip warn">
    {{teamName ? '「' + teamName + '」的邀请已失效或已使用' : '邀请已失效或已使用'}}
  </view>

  <!-- 空名片填空表单（kind='card' 邀请） -->
  <block wx:elif="{{isCardInvite}}">
    <view class="cardform-card">
      <view class="cardform-tip">负责人已预填部分信息（提示「预填」），补全必填项（带 *）后提交即可加入。</view>
      <view class="form-card">
        <view class="form-group" wx:for="{{cardSchema}}" wx:key="key" wx:if="{{item.visible}}">
          <text class="form-label">{{item.label}}<text class="req-star" wx:if="{{item.required}}"> *</text></text>
          <!-- 公众号二维码：只读预览（团队统一二维码，成员不可修改） -->
          <block wx:if="{{item.key === 'wechatOfficialQrcode'}}">
            <view class="form-qr" wx:if="{{form[item.key]}}">
              <image class="form-qr-img" src="{{form[item.key]}}" mode="aspectFit" />
            </view>
            <view class="form-qr-hint" wx:if="{{form[item.key]}}">由团队统一管理，不可修改</view>
            <view class="form-qr-hint" wx:else>由团队统一管理（暂未配置二维码）</view>
          </block>
          <!-- 业务简介：多行文本 -->
          <block wx:elif="{{item.key === 'intro'}}">
            <textarea
              class="form-textarea"
              placeholder="{{item.defaultValue ? '预填：' + item.defaultValue : '请输入' + item.label}}"
              value="{{form[item.key]}}"
              data-key="{{item.key}}"
              bindinput="onFieldInput"
              maxlength="500"
              auto-height
            ></textarea>
          </block>
          <!-- 其余：单行文本 -->
          <block wx:else>
            <input
              class="form-input"
              placeholder="{{item.defaultValue ? '预填：' + item.defaultValue : '请输入' + item.label}}"
              value="{{form[item.key]}}"
              data-key="{{item.key}}"
              bindinput="onFieldInput"
              maxlength="200"
            />
          </block>
        </view>
      </view>
    </view>
    <view class="bottom-actions">
      <view class="primary-btn {{isJoining ? 'disabled' : ''}}" bindtap="join">
        {{isJoining ? '提交中...' : '填写并加入'}}
      </view>
    </view>
  </block>

  <!-- 普通邀请：邀请码输入 / 凭 token 直接加入 -->
  <block wx:else>
    <view class="form-card">
      <view class="form-group">
        <text class="form-label">邀请码</text>
        <input
          class="form-input code-input"
          placeholder="请输入 6 位邀请码"
          value="{{code}}"
          bindinput="onCodeInput"
          maxlength="6"
        />
      </view>
    </view>
    <view class="bottom-actions">
      <view class="primary-btn {{isJoining ? 'disabled' : ''}}" bindtap="join">
        {{isJoining ? '加入中...' : (token ? '确认加入' : '加入团队')}}
      </view>
    </view>
  </block>
</view>
