/* 我的团队列表 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  background: #FFFFFF;
}

.header {
  padding: 16rpx 8rpx 24rpx;
}
.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #0F172A;
}
.header-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #64748B;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #64748B;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-lg);
  background: #EFF6FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.icon-team {
  width: 56rpx;
  height: 40rpx;
  border: 4rpx solid #3B82F6;
  border-radius: 6rpx;
  position: relative;
}
.icon-team::after {
  content: '';
  position: absolute;
  left: 50%;
  top: -14rpx;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #3B82F6;
  border-radius: 50%;
  transform: translateX(-50%);
}
.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #334155;
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748B;
  margin-bottom: 40rpx;
}
.empty-actions { display: flex; flex-direction: column; gap: 20rpx; width: 100%; }

.team-list { display: flex; flex-direction: column; gap: 20rpx; }

.team-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.04);
  border: 2rpx solid #E2E8F0;
}
.team-card-hover { background: #F8FAFC; }
.team-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.team-info { flex: 1; min-width: 0; }
.team-name-row { display: flex; align-items: center; gap: 12rpx; }
.team-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-meta { display: block; margin-top: 6rpx; font-size: 24rpx; color: #64748B; }

.role-badge {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-lg);
  flex-shrink: 0;
}
.role-owner { background: #FEF3C7; color: #B45309; }
.role-member { background: #E0F2FE; color: #0369A1; }

.team-arrow { color: #CBD5E1; font-size: 40rpx; margin-left: 12rpx; }

.bottom-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
}
.ghost-btn {
  background: #fff;
  color: #3B82F6;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid #BFDBFE;
}
.primary-btn.full, .ghost-btn.full { flex: 1; }
