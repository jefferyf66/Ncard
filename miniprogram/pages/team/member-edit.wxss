/* 编辑成员字段 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  background: #FFFFFF;
}
.header { padding: 16rpx 8rpx 24rpx; }
.header-title { font-size: 44rpx; font-weight: 700; color: #0F172A; }
.header-sub { display: block; margin-top: 8rpx; font-size: 26rpx; color: #64748B; }

.member-card {
  display: flex; align-items: center; background: #fff; border-radius: var(--radius-md);
  padding: 20rpx 24rpx; margin-bottom: 20rpx; border: 2rpx solid #E2E8F0;
}
.member-label { font-size: 24rpx; color: #64748B; margin-right: 12rpx; }
.member-id { font-size: 28rpx; color: #1F2937; font-weight: 600; }
.member-team { font-size: 24rpx; color: #3B82F6; }

.form-card {
  background: #fff; border-radius: var(--radius-lg); padding: 4rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.04); border: 2rpx solid #E2E8F0;
}
.form-group { padding: 24rpx 0; }
.form-label { font-size: 28rpx; font-weight: 600; color: #334155; }
.form-input {
  margin-top: 16rpx; height: 80rpx; background: #F8FAFC; border: 2rpx solid #E2E8F0;
  border-radius: var(--radius-sm); padding: 0 20rpx; font-size: 28rpx; color: #1F2937;
}
.form-divider { height: 2rpx; background: #F1F5F9; margin-top: 24rpx; }

.tips-card { margin-top: 24rpx; background: #EFF6FF; border-radius: var(--radius-md); padding: 20rpx 24rpx; }
.tips-text { font-size: 24rpx; color: #3B82F6; line-height: 1.6; }

.bottom-actions { position: fixed; left: 24rpx; right: 24rpx; bottom: 28rpx; }
.primary-btn {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); color: #fff;
  font-size: 30rpx; font-weight: 600; text-align: center;
  min-height: 88rpx; line-height: 88rpx; padding: 0 24rpx; border-radius: var(--radius-md);
}
.primary-btn.disabled { opacity: 0.6; }
