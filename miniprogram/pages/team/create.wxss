/* 创建团队 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  background: linear-gradient(175deg, #EFF6FF 0%, #F8FAFC 40%, #FEFCF7 100%);
}
.header { padding: 16rpx 8rpx 24rpx; }
.header-title { font-size: 44rpx; font-weight: 700; color: #0F172A; }
.header-sub { display: block; margin-top: 8rpx; font-size: 26rpx; color: #64748B; }

.form-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 12rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.04);
  border: 2rpx solid #E2E8F0;
}
.form-group { padding: 24rpx 0; }
.form-label { font-size: 28rpx; font-weight: 600; color: #334155; }
.required { color: #EF4444; margin-left: 6rpx; }
.form-input {
  margin-top: 16rpx;
  height: 80rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1F2937;
}
.input-error { border-color: #EF4444; }
.form-error { margin-top: 10rpx; font-size: 24rpx; color: #EF4444; }
.form-textarea {
  margin-top: 16rpx;
  width: 100%;
  min-height: 120rpx;
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}
.form-divider { height: 2rpx; background: #F1F5F9; }

.similar-tip {
  margin-top: 16rpx;
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
}
.similar-title { font-size: 24rpx; color: #B45309; }
.similar-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}
.similar-name { font-size: 26rpx; color: #92400E; font-weight: 600; }
.similar-meta { font-size: 24rpx; color: #B45309; }

.tips-card {
  margin-top: 24rpx;
  background: #EFF6FF;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
}
.tips-text { font-size: 24rpx; color: #3B82F6; line-height: 1.6; }

.bottom-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  display: flex;
  gap: 20rpx;
}
.primary-btn {
  flex: 1;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
}
.primary-btn.disabled { opacity: 0.6; }
.ghost-btn {
  flex: 1;
  background: #fff;
  color: #3B82F6;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid #BFDBFE;
}
