/* 团队详情 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  background: linear-gradient(175deg, #EFF6FF 0%, #F8FAFC 40%, #FEFCF7 100%);
}
.loading-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 160rpx 0; }
.loading-spinner {
  width: 56rpx; height: 56rpx; border: 6rpx solid #E2E8F0; border-top-color: #3B82F6;
  border-radius: 50%; animation: spin 0.8s linear infinite;
}
.loading-text { margin-top: 20rpx; font-size: 26rpx; color: #94A3B8; }
@keyframes spin { to { transform: rotate(360deg); } }

.team-header {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.04);
  border: 2rpx solid #E2E8F0;
}
.team-logo {
  width: 96rpx; height: 96rpx; border-radius: 18rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff; font-size: 44rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx;
}
.team-head-info { flex: 1; min-width: 0; }
.team-name { font-size: 36rpx; font-weight: 700; color: #0F172A; display: block; }
.team-meta { font-size: 24rpx; color: #94A3B8; margin-top: 6rpx; display: block; }
.role-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; flex-shrink: 0; }
.role-tag.owner { background: #FEF3C7; color: #B45309; }
.role-tag.member { background: #E0F2FE; color: #0369A1; }

.card-block { margin-top: 20rpx; background: #fff; border-radius: 20rpx; padding: 24rpx 28rpx; border: 2rpx solid #E2E8F0; }
.block-text { font-size: 28rpx; color: #475569; line-height: 1.6; }

.block-action { display: flex; align-items: center; }
.action-icon {
  width: 64rpx; height: 64rpx; border-radius: 14rpx; background: #EFF6FF;
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx;
}
.icon-invite { width: 32rpx; height: 32rpx; border: 4rpx solid #3B82F6; border-radius: 50%; position: relative; }
.icon-invite::after {
  content: ''; position: absolute; right: -10rpx; top: -2rpx;
  width: 18rpx; height: 18rpx; border: 4rpx solid #3B82F6; border-radius: 50%;
}
.action-text { flex: 1; }
.action-title { font-size: 30rpx; font-weight: 600; color: #1F2937; display: block; }
.action-sub { font-size: 22rpx; color: #94A3B8; margin-top: 4rpx; display: block; }
.action-arrow { color: #CBD5E1; font-size: 40rpx; }

.section-card { margin-top: 20rpx; background: #fff; border-radius: 20rpx; padding: 24rpx 28rpx; border: 2rpx solid #E2E8F0; }
.section-header { margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #334155; }

.member-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid #F1F5F9; }
.member-item:last-child { border-bottom: none; }
.member-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%; background: #E2E8F0; color: #475569;
  font-size: 26rpx; display: flex; align-items: center; justify-content: center; margin-right: 18rpx;
}
.member-info { flex: 1; min-width: 0; }
.member-name-row { display: flex; align-items: center; gap: 12rpx; }
.member-name { font-size: 28rpx; color: #1F2937; }
.role-badge { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 20rpx; }
.role-owner { background: #FEF3C7; color: #B45309; }
.role-member { background: #E0F2FE; color: #0369A1; }
.member-actions { display: flex; gap: 24rpx; flex-shrink: 0; }
.act-edit { font-size: 26rpx; color: #3B82F6; }
.act-remove { font-size: 26rpx; color: #EF4444; }
.empty-members { padding: 24rpx 0; text-align: center; font-size: 26rpx; color: #94A3B8; }

.bottom-actions { position: fixed; left: 24rpx; right: 24rpx; bottom: 28rpx; }
.danger-btn {
  background: #fff; color: #EF4444; font-size: 30rpx; font-weight: 600; text-align: center;
  padding: 24rpx 0; border-radius: 16rpx; border: 2rpx solid #FECACA;
}
.owner-actions { margin: 28rpx 24rpx 0; }
.owner-tip-text { font-size: 24rpx; color: #94A3B8; line-height: 1.6; }
.owner-actions .danger-btn { margin-top: 16rpx; }

/* 邀请弹窗 */
.modal-overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(15,23,42,0.5);
  display: flex; align-items: flex-end; z-index: 100;
}
.modal-content {
  width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 40rpx 40rpx 60rpx;
}
.modal-title { font-size: 34rpx; font-weight: 700; color: #0F172A; text-align: center; display: block; margin-bottom: 32rpx; }
.code-box {
  display: flex; align-items: center; background: #F8FAFC; border: 2rpx solid #E2E8F0;
  border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx;
}
.code-label { font-size: 26rpx; color: #64748B; }
.code-value { flex: 1; text-align: center; font-size: 44rpx; font-weight: 700; letter-spacing: 8rpx; color: #1F2937; }
.copy-btn { font-size: 26rpx; color: #3B82F6; font-weight: 600; padding: 8rpx 20rpx; border: 2rpx solid #BFDBFE; border-radius: 12rpx; }
.modal-tip { font-size: 24rpx; color: #94A3B8; line-height: 1.6; display: block; margin-bottom: 24rpx; }
.share-btn {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); color: #fff;
  font-size: 30rpx; font-weight: 600; border-radius: 16rpx; margin-bottom: 16rpx;
}
.modal-close { text-align: center; font-size: 28rpx; color: #64748B; padding: 16rpx 0; }
