/* 团队详情 */
.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  background: #FFFFFF;
}
.loading-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 160rpx 0; }
.loading-text { margin-top: 20rpx; font-size: 26rpx; color: #64748B; }

.team-header {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(29, 78, 216, 0.04);
  border: 2rpx solid #E2E8F0;
}
.team-logo {
  width: 96rpx; height: 96rpx; border-radius: var(--radius-md);
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff; font-size: 44rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx;
}
.team-head-info { flex: 1; min-width: 0; }
.team-name { font-size: 36rpx; font-weight: 700; color: #0F172A; display: block; }
.team-meta { font-size: 24rpx; color: #64748B; margin-top: 6rpx; display: block; }
.role-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: var(--radius-lg); flex-shrink: 0; }
.role-tag.owner { background: #FEF3C7; color: #B45309; }
.role-tag.member { background: #E0F2FE; color: #0369A1; }

.card-block { margin-top: 20rpx; background: #fff; border-radius: var(--radius-lg); padding: 24rpx 28rpx; border: 2rpx solid #E2E8F0; }
.block-text { font-size: 28rpx; color: #475569; line-height: 1.6; }

.block-action { display: flex; align-items: center; }
.action-icon {
  width: 64rpx; height: 64rpx; border-radius: var(--radius-md); background: #EFF6FF;
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx;
}
.icon-invite { width: 32rpx; height: 32rpx; border: 4rpx solid #3B82F6; border-radius: 50%; position: relative; }
.icon-invite::after {
  content: ''; position: absolute; right: -10rpx; top: -2rpx;
  width: 18rpx; height: 18rpx; border: 4rpx solid #3B82F6; border-radius: 50%;
}
.action-text { flex: 1; }
.action-title { font-size: 30rpx; font-weight: 600; color: #1F2937; display: block; }
.action-sub { font-size: 24rpx; color: #64748B; margin-top: 4rpx; display: block; }
.action-arrow { color: #CBD5E1; font-size: 40rpx; }

.section-card { margin-top: 20rpx; background: #fff; border-radius: var(--radius-lg); padding: 24rpx 28rpx; border: 2rpx solid #E2E8F0; }
.section-header { margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #334155; }

.member-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid #F1F5F9; }
.member-item:last-child { border-bottom: none; }
.member-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%; background: #E2E8F0; color: #475569;
  font-size: 26rpx; display: flex; align-items: center; justify-content: center; margin-right: 18rpx;
}
.member-info { flex: 1; min-width: 0; }
.member-name-row { display: flex; align-items: center; gap: 12rpx; }
.member-name { font-size: 28rpx; color: #1F2937; }
.role-badge { font-size: 20rpx; padding: 2rpx 12rpx; border-radius: var(--radius-lg); }
.role-owner { background: #FEF3C7; color: #B45309; }
.role-member { background: #E0F2FE; color: #0369A1; }
.member-actions { display: flex; gap: 24rpx; flex-shrink: 0; }
.act-edit {
  font-size: 26rpx; color: #3B82F6;
  padding: 20rpx 8rpx; margin: -20rpx 0;
}
.act-remove {
  font-size: 26rpx; color: #EF4444;
  padding: 20rpx 0 20rpx 16rpx; margin: -20rpx 0;
}
.empty-members { padding: 24rpx 0; text-align: center; font-size: 26rpx; color: #64748B; }

.bottom-actions { position: fixed; left: 24rpx; right: 24rpx; bottom: 28rpx; }
.danger-btn {
  background: #fff; color: #EF4444; font-size: 30rpx; font-weight: 600; text-align: center;
  min-height: 88rpx; line-height: 88rpx; padding: 0 24rpx;
  border-radius: var(--radius-md); border: 2rpx solid #FECACA;
}
.owner-actions { margin: 28rpx 24rpx 0; }
.owner-tip-text { font-size: 24rpx; color: #64748B; line-height: 1.6; }
.owner-actions .danger-btn { margin-top: 16rpx; }

/* 邀请弹窗 */
.modal-overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(15,23,42,0.5);
  display: flex; align-items: flex-end; z-index: 1000;
}
.modal-content {
  width: 100%; background: #fff; border-radius: var(--radius-lg) var(--radius-lg) 0 0; padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}
.modal-title { font-size: 34rpx; font-weight: 700; color: #0F172A; text-align: center; display: block; margin-bottom: 32rpx; }
.code-box {
  display: flex; align-items: center; background: #F8FAFC; border: 2rpx solid #E2E8F0;
  border-radius: var(--radius-md); padding: 24rpx; margin-bottom: 20rpx;
}
.code-label { font-size: 26rpx; color: #64748B; }
.code-value { flex: 1; text-align: center; font-size: 44rpx; font-weight: 700; letter-spacing: 8rpx; color: #1F2937; }
.copy-btn { font-size: 26rpx; color: #3B82F6; font-weight: 600; padding: 8rpx 20rpx; border: 2rpx solid #BFDBFE; border-radius: var(--radius-sm); }
.modal-tip { font-size: 24rpx; color: #64748B; line-height: 1.6; display: block; margin-bottom: 24rpx; }
.share-btn {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); color: #fff;
  font-size: 30rpx; font-weight: 600; border-radius: var(--radius-md); margin-bottom: 16rpx;
}
.modal-close { text-align: center; font-size: 28rpx; color: #64748B; padding: 16rpx 0; }

/* 公开目录：成员网格 */
.member-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 8rpx;
}
.member-card {
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: var(--radius-md);
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.member-avatar-img {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #E2E8F0; color: #475569;
  font-size: 36rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 14rpx;
}
.member-card-name { font-size: 28rpx; font-weight: 600; color: #1F2937; }
.member-card-sub { font-size: 24rpx; color: #64748B; margin-top: 6rpx; line-height: 1.5; }

/* 分享团队目录按钮 */
.share-dir-card { margin-top: 20rpx; }
.share-dir-btn {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); color: #fff;
  font-size: 30rpx; font-weight: 600; border-radius: var(--radius-md);
}

/* 设置区（owner）：目录公开开关 */
.settings-card { margin-top: 20rpx; background: #fff; border-radius: var(--radius-lg); padding: 8rpx 28rpx; border: 2rpx solid #E2E8F0; }
.settings-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0;
}
.settings-text { flex: 1; min-width: 0; padding-right: 20rpx; }
.settings-title { font-size: 30rpx; font-weight: 600; color: #1F2937; display: block; }
.settings-sub { font-size: 24rpx; color: #64748B; margin-top: 6rpx; display: block; line-height: 1.5; }
.settings-switch { flex-shrink: 0; }

/* 白名单提示 */
.whitelist-tip .action-icon {
  width: 64rpx; height: 64rpx; border-radius: var(--radius-md); background: #FEF3C7;
  display: flex; align-items: center; justify-content: center; margin-right: 20rpx;
}
.icon-lock {
  width: 28rpx; height: 24rpx; border: 4rpx solid #B45309; border-radius: 6rpx; position: relative;
}
.icon-lock::before {
  content: ''; position: absolute; top: -14rpx; left: 50%; transform: translateX(-50%);
  width: 18rpx; height: 14rpx; border: 4rpx solid #B45309; border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}
.join-cta {
  margin-top: 16rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600; color: #3B82F6;
  background: #EFF6FF; border-radius: var(--radius-sm);
}

/* 团队名片配置入口图标 */
.icon-card { width: 36rpx; height: 28rpx; border: 4rpx solid #3B82F6; border-radius: 6rpx; position: relative; }
.icon-card::after {
  content: ''; position: absolute; left: 6rpx; right: 6rpx; top: 8rpx; height: 4rpx;
  background: #3B82F6; box-shadow: 0 10rpx 0 #3B82F6;
}

/* 空名片分享按钮 */
.share-actions { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid #F1F5F9; }
.share-card-btn {
  background: #EFF6FF; color: #2563EB; font-size: 28rpx; font-weight: 600; text-align: center;
  padding: 22rpx 0; border-radius: var(--radius-md); border: 2rpx solid #BFDBFE;
}

/* 团队名片配置弹层 */
.config-modal { max-height: 82vh; display: flex; flex-direction: column; }
.schema-scroll { max-height: 52vh; margin: 8rpx 0 20rpx; }
.schema-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 2rpx solid #F1F5F9; }
.schema-row:last-child { border-bottom: none; }
.schema-main { flex: 1; min-width: 0; padding-right: 20rpx; }
.schema-label { font-size: 28rpx; color: #1F2937; font-weight: 600; display: block; margin-bottom: 12rpx; }
.schema-default {
  background: #F8FAFC; border: 2rpx solid #E2E8F0; border-radius: var(--radius-sm);
  padding: 14rpx 18rpx; font-size: 26rpx; color: #334155; width: 100%; box-sizing: border-box;
}
.schema-toggles { display: flex; gap: 12rpx; flex-shrink: 0; }
.schema-toggle {
  font-size: 24rpx; color: #94A3B8; padding: 10rpx 18rpx; border-radius: var(--radius-lg);
  border: 2rpx solid #E2E8F0; background: #F8FAFC;
}
.schema-toggle.on { color: #2563EB; border-color: #BFDBFE; background: #EFF6FF; }
.schema-toggle.on.req { color: #fff; background: #3B82F6; border-color: #3B82F6; }
/* 团队名片配置：业务简介多行文本 */
.schema-default-textarea {
  width: 100%; box-sizing: border-box; min-height: 140rpx;
  background: #F8FAFC; border: 2rpx solid #E2E8F0; border-radius: var(--radius-sm);
  padding: 14rpx 18rpx; font-size: 26rpx; color: #334155; line-height: 1.5;
}
/* 团队名片配置：公众号二维码上传/预览 */
.schema-qr { margin-top: 6rpx; }
.schema-qr-img { width: 180rpx; height: 180rpx; border-radius: var(--radius-sm); border: 2rpx solid #E2E8F0; background: #F8FAFC; }
.schema-qr-ph {
  width: 180rpx; height: 80rpx; display: flex; align-items: center; justify-content: center;
  border: 2rpx dashed #CBD5E1; border-radius: var(--radius-sm); color: #94A3B8; font-size: 24rpx; background: #F8FAFC;
}
.save-btn {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); color: #fff;
  font-size: 30rpx; font-weight: 600; border-radius: var(--radius-md); margin-bottom: 12rpx;
}
