.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 显式 content-box：高度不含 safe-area 内边距，防止内容区被 env() 吃掉后 flex 压缩图标 */
  box-sizing: content-box;
  height: 100rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: row;
  align-items: center;
  z-index: 1000;
}

/* 白色底板只垫下半段（含 safe-area 区），上半段全透明让页面内容透出，
   图标文字约有一半悬浮在白底之外；圆角上缘 + 上扬阴影强化悬浮感 */
.tab-bar::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56rpx;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(15, 23, 42, 0.08);
}

.tab-item {
  flex: 1;
  height: 100%;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #64748B;
}

.tab-item.active {
  color: #3B82F6;
}

.tab-text {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1;
}

/* 图标：本地 PNG（96x96，灰/蓝双色），<image> 组件加载，兼容性最稳 */
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0; /* 禁止 flex 压缩图标 */
  display: block;
}

.tab-plus {
  flex: 1;
  height: 100%;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-plus .plus-sign {
  width: 84rpx;
  height: 84rpx;
  margin-top: -40rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.35);
}
.tab-plus:active .plus-sign {
  opacity: 0.85;
}
