.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  /* 显式 content-box：高度不含 safe-area 内边距，防止内容区被 env() 吃掉后 flex 压缩图标 */
  box-sizing: content-box;
  height: 100rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  /* 悬浮效果：顶部渐变透明，内容可透出（各 tab 页已预留 160-180rpx 底部空间） */
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0, #FFFFFF 28rpx);
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.06);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #64748B;
}

.tab-item.active {
  color: #3B82F6;
}

.tab-text {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1;
}

/* 图标：本地 PNG（96x96，灰/蓝双色），<image> 组件加载，兼容性最稳 */
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0; /* 禁止 flex 压缩图标 */
  display: block;
}

.tab-plus {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.tab-plus .plus-sign {
  width: 84rpx;
  height: 84rpx;
  margin-top: -40rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.35);
}
.tab-plus:active .plus-sign {
  opacity: 0.85;
}
