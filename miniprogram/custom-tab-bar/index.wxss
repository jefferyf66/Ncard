.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  border-top: 1rpx solid #EEF1F5;
  z-index: 1000;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888780;
}

.tab-item.active {
  color: #3B82F6;
}

.tab-text {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  color: inherit;
}

/* 名片：卡片 + 横线 */
.icon-card {
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}
.icon-card::after {
  content: '';
  position: absolute;
  left: 7rpx;
  right: 7rpx;
  top: 9rpx;
  height: 3rpx;
  background: currentColor;
  box-shadow: 0 9rpx 0 currentColor;
}

/* 名片夹：两叠卡片 */
.icon-stack {
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}
.icon-stack::before {
  content: '';
  position: absolute;
  left: 8rpx;
  right: -6rpx;
  top: -8rpx;
  height: 100%;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  background: #FFFFFF;
  z-index: -1;
}

/* 团队：两个圆（人） */
.icon-team {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.icon-team::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

/* 我的：头 + 肩 */
.icon-user {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.icon-user::after {
  content: '';
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  bottom: -10rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 50% 50% 0 0;
}

/* 中央凸起＋按钮 */
.tab-plus {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.tab-plus .plus-sign {
  width: 84rpx;
  height: 84rpx;
  margin-top: -40rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.35);
}
.tab-plus:active .plus-sign {
  opacity: 0.85;
}
