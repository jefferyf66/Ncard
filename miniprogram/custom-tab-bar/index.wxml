<view class="tab-bar" wx:if="{{!hidden}}">
  <view class="tab-item {{selected === 0 ? 'active' : ''}}" data-path="/pages/index/index" bindtap="switchTab">
    <image class="tab-icon" style="width: 24px; height: 24px; flex-shrink: 0;" src="{{selected === 0 ? '/assets/tabbar/card-active.png' : '/assets/tabbar/card.png'}}" mode="aspectFit" binderror="onIconError" data-name="card" />
    <view class="tab-text">名片</view>
  </view>
  <view class="tab-item {{selected === 1 ? 'active' : ''}}" data-path="/pages/list/index" bindtap="switchTab">
    <image class="tab-icon" style="width: 24px; height: 24px; flex-shrink: 0;" src="{{selected === 1 ? '/assets/tabbar/stack-active.png' : '/assets/tabbar/stack.png'}}" mode="aspectFit" binderror="onIconError" data-name="stack" />
    <view class="tab-text">名片夹</view>
  </view>

  <view class="tab-plus" bindtap="onPlusTap">
    <text class="plus-sign">＋</text>
  </view>

  <view class="tab-item {{selected === 2 ? 'active' : ''}}" data-path="/pages/team/list" bindtap="switchTab">
    <image class="tab-icon" style="width: 24px; height: 24px; flex-shrink: 0;" src="{{selected === 2 ? '/assets/tabbar/team-active.png' : '/assets/tabbar/team.png'}}" mode="aspectFit" binderror="onIconError" data-name="team" />
    <view class="tab-text">团队</view>
  </view>
  <view class="tab-item {{selected === 3 ? 'active' : ''}}" data-path="/pages/profile/index" bindtap="switchTab">
    <image class="tab-icon" style="width: 24px; height: 24px; flex-shrink: 0;" src="{{selected === 3 ? '/assets/tabbar/user-active.png' : '/assets/tabbar/user.png'}}" mode="aspectFit" binderror="onIconError" data-name="user" />
    <view class="tab-text">我的</view>
  </view>
</view>
